#!/usr/bin/env bash
set -euo pipefail

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "$test_dir/../.." && pwd -P)"

python3 "$repo_root/.github/scripts/verify_mise_lock.py" \
  "$repo_root/.github/mise/checkrun-ci.toml" \
  "$repo_root/.github/mise/mise.lock"

python3 - \
  "$repo_root/.github/scripts/verify_mise_lock.py" \
  "$repo_root/.github/workflows/test.yml" \
  "$repo_root/.github/workflows/retry-infrastructure.yml" \
  "$repo_root/.github/cgraf78-actions.lock" \
  "$repo_root/.github/workflows/update-mise-lock.yml" <<'PY'
from __future__ import annotations

import importlib.util
import re
import sys
from copy import deepcopy
from pathlib import Path

script = Path(sys.argv[1])
workflow_path = Path(sys.argv[2])
workflow = workflow_path.read_text(encoding="utf-8")
retry_workflow_path = Path(sys.argv[3])
retry_workflow = retry_workflow_path.read_text(encoding="utf-8")
lock_path = Path(sys.argv[4])
if not lock_path.is_file() or lock_path.is_symlink():
    raise AssertionError("cgraf78/actions lock is missing")
lock_text = lock_path.read_text(encoding="utf-8")
if re.fullmatch(r"[0-9a-f]{40}\n", lock_text) is None:
    raise AssertionError(
        "cgraf78/actions lock must contain one lowercase full commit SHA"
    )
actions_sha = lock_text[:-1]
update_workflow_path = Path(sys.argv[5])
update_workflow = update_workflow_path.read_text(encoding="utf-8")
spec = importlib.util.spec_from_file_location("verify_mise_lock", script)
if spec is None or spec.loader is None:
    raise RuntimeError(f"cannot load {script}")
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)

config = {
    "settings": {"lockfile_platforms": ["linux-x64"]},
    "tools": {"aqua:owner/tool": "latest"},
}
entry = {
    "version": "1.2.3",
    "backend": "aqua:owner/tool",
    "platforms.linux-x64": {"url": "https://example.test/tool"},
}
lock = {"tools": {"aqua:owner/tool": [entry]}}


def assert_error(expected: str, candidate_config: dict, candidate_lock: dict) -> None:
    """Require one focused fixture to produce its expected diagnostic."""
    errors = module.verify(candidate_config, candidate_lock)
    if expected not in errors:
        raise AssertionError(f"missing {expected!r} in {errors!r}")


if module.verify(config, lock):
    raise AssertionError("valid fixture was rejected")

assert_error("missing lock entry: aqua:owner/tool", config, {"tools": {}})

stale = deepcopy(lock)
stale["tools"]["aqua:owner/stale"] = [deepcopy(entry)]
assert_error("stale lock entry: aqua:owner/stale", config, stale)

missing_platform = deepcopy(lock)
del missing_platform["tools"]["aqua:owner/tool"][0]["platforms.linux-x64"]
assert_error(
    "aqua:owner/tool: missing platform linux-x64", config, missing_platform
)

missing_url = deepcopy(lock)
missing_url["tools"]["aqua:owner/tool"][0]["platforms.linux-x64"] = {}
assert_error("aqua:owner/tool: linux-x64 has no locked URL", config, missing_url)

duplicate = deepcopy(lock)
duplicate["tools"]["aqua:owner/tool"].append(deepcopy(entry))
assert_error("aqua:owner/tool: expected exactly one locked version", config, duplicate)


def job_block(source: str, name: str) -> str:
    """Return one top-level job block from the repository workflow."""
    lines = source.splitlines()
    marker = f"  {name}:"
    try:
        start = lines.index(marker)
    except ValueError as error:
        raise AssertionError(f"missing workflow job: {name}") from error
    end = len(lines)
    for index in range(start + 1, len(lines)):
        line = lines[index]
        if line.startswith("  ") and not line.startswith("    ") and line.endswith(":"):
            end = index
            break
    return "\n".join(lines[start:end])


def step_block(source: str, name: str) -> str:
    """Return one named step block from a workflow job."""
    lines = source.splitlines()
    marker = f"      - name: {name}"
    try:
        start = lines.index(marker)
    except ValueError as error:
        raise AssertionError(f"missing workflow step: {name}") from error
    end = next(
        (
            index
            for index in range(start + 1, len(lines))
            if lines[index].startswith("      - ")
        ),
        len(lines),
    )
    return "\n".join(lines[start:end])


shell_job = job_block(workflow, "shell")
if "branches: [main]" not in workflow:
    raise AssertionError("push CI must target only the maintained main branch")
shell_ref = f"uses: cgraf78/actions/.github/workflows/shell-ci.yml@{actions_sha}"
if shell_job.count(shell_ref) != 1:
    raise AssertionError("shell workflow must use the locked actions revision")
if not (workflow_path.parents[2] / "test/shellcheck-files.txt").is_file():
    raise AssertionError("shared ShellCheck inventory is missing")
if "setup: checkrun" not in shell_job:
    raise AssertionError("main shell job must retain the named Checkrun setup")
if "shellcheck-inventory-path: test/shellcheck-files.txt" not in shell_job:
    raise AssertionError("main shell job must include the shared ShellCheck gate")
if "test-command: test/checkrun-test" not in shell_job:
    raise AssertionError("main shell job must run the complete repository suite")

actions_sync_job = job_block(workflow, "actions-sync")
for contract in [
    "name: cgraf78/actions sync",
    "runs-on: ubuntu-24.04",
    "contents: read",
    "persist-credentials: false",
    (
        "uses: cgraf78/actions/.github/actions/verify-consumer-sync@"
        f"{actions_sha}"
    ),
]:
    if contract not in actions_sync_job:
        raise AssertionError(f"actions sync job must include {contract}")
checkout_lines = [
    line
    for line in actions_sync_job.splitlines()
    if re.fullmatch(r"      - uses: actions/checkout@[0-9a-f]{40}(?: # .+)?", line)
]
if len(checkout_lines) != 1:
    raise AssertionError("actions sync job must use one immutable checkout revision")

retry_ref = f"uses: cgraf78/actions/.github/actions/infra-retry@{actions_sha}"
if retry_workflow.count(retry_ref) != 1:
    raise AssertionError("infrastructure retry must use the locked actions revision")

publish_job = job_block(update_workflow, "publish")
mise_refs = re.findall(r"uses: jdx/mise-action@([0-9a-f]{40})", update_workflow)
if len(mise_refs) != 1:
    raise AssertionError("Mise refresh must use one immutable action revision")
publish_lines = publish_job.splitlines()
checkout_starts = [
    index
    for index, line in enumerate(publish_lines)
    if re.fullmatch(r"      - uses: actions/checkout@[0-9a-f]{40}(?: # .+)?", line)
]
if len(checkout_starts) != 1:
    raise AssertionError("Mise publish job must use one immutable checkout revision")
checkout_start = checkout_starts[0]
checkout_end = next(
    (
        index
        for index in range(checkout_start + 1, len(publish_lines))
        if publish_lines[index].startswith("      - ")
    ),
    len(publish_lines),
)
checkout_step = "\n".join(publish_lines[checkout_start:checkout_end])
preflight_step = step_block(publish_job, "Require the repository-scoped deploy key")
preflight_start = publish_lines.index(
    "      - name: Require the repository-scoped deploy key"
)
if preflight_start >= checkout_start:
    raise AssertionError("Mise deploy-key preflight must run before checkout")
if "CHECKRUN_MISE_REFRESH_DEPLOY_KEY is not configured" not in preflight_step:
    raise AssertionError("Mise deploy-key preflight must fail when its secret is absent")
for setting in [
    "          ref: ${{ needs.refresh.outputs.base_sha }}",
    "          path: repo",
    "          ssh-key: ${{ secrets.CHECKRUN_MISE_REFRESH_DEPLOY_KEY }}",
    "          token: unused-by-ssh-checkout",
    "          persist-credentials: true",
]:
    if setting not in checkout_step:
        raise AssertionError(f"Mise publish checkout must include {setting.strip()}")
if "gh repo clone" in publish_job:
    raise AssertionError("Mise publish job must not use the unretired gh clone path")
pr_step = step_block(publish_job, "Open pull request and enable auto-merge")
for required in [
    'remote_ref="refs/heads/$UPDATE_BRANCH"',
    "owner=${GITHUB_REPOSITORY%%/*}",
    'head="$owner:$UPDATE_BRANCH"',
    'base=$(jq -r \'.[0].base.ref\' <<<"$prs")',
    'head_repo=$(jq -r \'.[0].head.repo.full_name\' <<<"$prs")',
    'head_ref=$(jq -r \'.[0].head.ref\' <<<"$prs")',
    'if [[ "$base" != "$BASE_BRANCH" ]]; then',
    'if [[ "$head_repo" != "$GITHUB_REPOSITORY" ]]; then',
    'if [[ "$head_ref" != "$UPDATE_BRANCH" ]]; then',
    "unexpected base on Mise refresh PR",
    "unexpected head repository on Mise refresh PR",
    "unexpected head branch on Mise refresh PR",
    "published_sha=$(git rev-parse HEAD)",
    'git push origin "HEAD:$remote_ref" \\\n            "--force-with-lease=$remote_ref:$published_sha"',
    'gh pr merge "$number" --auto --squash',
]:
    if required not in pr_step:
        raise AssertionError(f"Mise PR step must include {required}")
ordered_operations = [
    'gh pr create --base "$BASE_BRANCH"',
    "git commit --amend",
    'git push origin "HEAD:$remote_ref"',
    'gh pr merge "$number" --auto --squash',
]
positions = [pr_step.index(operation) for operation in ordered_operations]
if positions != sorted(positions):
    raise AssertionError("Mise PR synchronize and auto-merge operations are misordered")
for obsolete in [
    "actions: write",
    "gh workflow run test.yml",
    "full cross-platform matrix dispatched by this workflow",
]:
    if obsolete in publish_job:
        raise AssertionError(f"Mise publish job retains obsolete path: {obsolete}")
PY

printf 'ci-toolchain-test: ok\n'
