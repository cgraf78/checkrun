#!/usr/bin/env bash
# Exercise the real tmux lint adapter through the public CLI on private sockets.

set -o pipefail
export NO_COLOR=1

test_dir="$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd -P)"
# shellcheck source=../helpers.sh
. "$test_dir/helpers.sh"
_require_compatible_libc "tmux-lint-test"

AUTOLINT="$test_dir/../bin/autolint"
export CHECKRUN_CONFIG_DIR
CHECKRUN_CONFIG_DIR=$(_checkrun_default_config_dir)

if [[ -n ${CI_TMUX_PINNED_BIN:-} ]]; then
  # The pinned build takes precedence over any package manager installation.
  export PATH="${CI_TMUX_PINNED_BIN%/*}:$PATH"
  _assert_eq "tmux.conf: CI runs the pinned parser" "$CI_TMUX_PINNED_BIN" "$(type -P tmux)"
fi
if _tmux_lint_version=$(tmux -V 2>/dev/null) && [[ $_tmux_lint_version != 'tmux '[012].* ]]; then
  _tmux_lint_dir=$(_tmpdir)
  _tmux_lint_config_dir="$_tmux_lint_dir/space ; \$value \"quotes\" {tmux}"
  mkdir -p "$_tmux_lint_dir/bin" "$_tmux_lint_dir/home" "$_tmux_lint_dir/tmp" "$_tmux_lint_config_dir"
  _tmux_lint_file="$_tmux_lint_config_dir/tmux.conf"
  # Spelling is a separate registry phase. Keep user-installed shims out of
  # this test's result when the isolated HOME hides their backing binaries.
  ln -s "$(type -P true)" "$_tmux_lint_dir/bin/typos"
  # Record the actual socket used by each dry-run to assert cleanup on both
  # exit paths without scanning /tmp or contacting unrelated servers.
  cat >"$_tmux_lint_dir/bin/tmux" <<'TMUX_LINT'
#!/usr/bin/env bash
if [[ $1 == -S && $* == *' start-server '* ]]; then
  printf '%s\n' "$2" >>"$TMUX_TEST_SOCKET_LOG"
fi
exec "$TMUX_TEST_PARSER" "$@"
TMUX_LINT
  chmod +x "$_tmux_lint_dir/bin/tmux"
  _tmux_socket_log="$_tmux_lint_dir/sockets"
  : >"$_tmux_socket_log"
  _tmux_lint_env=(env -u TMUX -u TMUX_PANE
    "PATH=$_tmux_lint_dir/bin:$PATH" "HOME=$_tmux_lint_dir/home"
    "XDG_CONFIG_HOME=$_tmux_lint_dir/home/.config"
    "TMUX_TEST_PARSER=$(type -P tmux)" "TMUX_TEST_SOCKET_LOG=$_tmux_socket_log"
    "TMUX_TMPDIR=$_tmux_lint_dir/tmp" "TMPDIR=$_tmux_lint_dir/tmp")
  # Exercise the public linter from a shell with no tmux server. The config
  # must be parsed without loading the user's startup file or running jobs.
  # Foreground run-shell makes the marker observable before lint can return
  # if either file is executed instead of only parsing the target.
  printf '%s\n' "run-shell 'touch \"\$HOME/startup-ran\"'" >"$_tmux_lint_dir/home/.tmux.conf"
  printf '%s\n' "run-shell 'touch \"\$HOME/config-ran\"'" >"$_tmux_lint_file"
  set +e
  output=$("${_tmux_lint_env[@]}" "$AUTOLINT" "$_tmux_lint_file" 2>&1)
  rc=$?
  set -e
  _assert_exit "tmux.conf: a valid config passes without a tmux server" 0 "$rc"
  if [[ -e "$_tmux_lint_dir/home/startup-ran" || -e "$_tmux_lint_dir/home/config-ran" ]]; then
    _fail "tmux.conf: lint executed a startup or config command"
  else
    _pass "tmux.conf: lint executes no startup or config commands"
  fi

  printf '%s\n' 'invalid-checkrun-tmux-command' >"$_tmux_lint_file"
  set +e
  output=$("${_tmux_lint_env[@]}" "$AUTOLINT" "$_tmux_lint_file" 2>&1)
  rc=$?
  set -e
  _assert_exit "tmux.conf: invalid config fails without a tmux server" 1 "$rc"
  _assert_contains_path_arg_suffix "tmux.conf: invalid config reports its exact path and error" \
    "" "$_tmux_lint_file" ":1: unknown command: invalid-checkrun-tmux-command" "$output"
  _assert_eq "tmux.conf: both dry-runs used private sockets" 2 \
    "$(wc -l <"$_tmux_socket_log" | tr -d '[:space:]')"
  while IFS= read -r _tmux_lint_socket; do
    if [[ -e ${_tmux_lint_socket%/*} ]]; then
      _fail "tmux.conf: lint left a private socket directory behind"
    else
      _pass "tmux.conf: lint cleans up its private socket directory"
    fi
  done <"$_tmux_socket_log"
elif [[ -n ${CI_TMUX_PINNED_BIN:-} ]]; then
  _fail "tmux.conf: the pinned parser must support source-file -n"
else
  _skip "tmux.conf: real headless lint needs tmux with source-file -n"
fi

_test_summary
