_run_pgid_case "supervisor killed before cancellation gets no group TERM" \
  external-kill-before-cancel 143
_run_pgid_case "supervisor killed during the grace gets no group KILL" \
  external-kill-during-grace 143
_run_pgid_case "job table misreport during cancellation still releases" \
  jobs-false-exit-cancel 143
_run_pgid_case "TERM interrupting the wait for a misreported supervisor" \
