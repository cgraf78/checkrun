        if pid_path.exists():
            backend_pids.append(int(pid_path.read_text(encoding="ascii")))
        if worker_path.exists():
            worker_pids.append(int(worker_path.read_text(encoding="ascii")))
    owned_pids = backend_pids + worker_pids
    for extra_pid_path in extra_pid_paths():
        extra_pid = read_pid(extra_pid_path)
        if extra_pid is not None:
            owned_pids.append(extra_pid)
    if (root / "planner.pid").exists():
        owned_pids.append(int((root / "planner.pid").read_text(encoding="ascii")))
    deadline = time.monotonic() + 1
    remaining = []
    while True:
        remaining = [(pid, process_state(pid)) for pid in owned_pids]
        remaining = [(pid, state) for pid, state in remaining if state]
        live_remaining = [
            (pid, state) for pid, state in remaining if process_state_is_live(state)
        ]
