#!/usr/bin/env bash
# autolint-cancellation-test - process and scratch lifecycle invariants.

set -o pipefail
export NO_COLOR=1

# Bash can neither trap nor reset a signal that was ignored when it started,
# and every fixture inherits that disposition. A non-interactive shell starts
# an asynchronous command with SIGINT ignored, and `nohup` ignores SIGHUP, so
# those scenarios would never reach their handlers. Python reports an
# inherited SIG_IGN; a failed probe prints nothing and changes nothing.
_signal_probe='import signal
print(" ".join(name for name in ("SIGHUP", "SIGINT", "SIGTERM")
               if signal.getsignal(getattr(signal, name)) is signal.SIG_IGN))'
_signal_reset='import os, signal, sys
for name in ("SIGINT", "SIGTERM", "SIGPIPE", "SIGXFSZ"):
    if hasattr(signal, name):
        signal.signal(getattr(signal, name), signal.SIG_DFL)
os.execv(sys.argv[1], sys.argv[1:])'
_ignored_signals=$(python3 -I -c "$_signal_probe" 2>/dev/null) || _ignored_signals=""
case " $_ignored_signals " in
  *" SIGINT "* | *" SIGTERM "*)
    # Nothing asked for INT or TERM to be ignored, so re-exec once with the
    # default action. Python itself ignores SIGPIPE and SIGXFSZ, so reset
    # those as well; an ignored HUP stays ignored, since `nohup` asked for it.
    if [ -z "${AUTOLINT_CANCEL_SIGNAL_RESET:-}" ]; then
      export AUTOLINT_CANCEL_SIGNAL_RESET=1
      # The new shell would source the startup file again.
      unset BASH_ENV ENV
      exec python3 -I -c "$_signal_reset" "$BASH" "${BASH_SOURCE[0]}" "$@"
    fi
    ;;
esac
unset _signal_probe _signal_reset
# harness-test runs only this header, with signals ignored, to prove that the
# restart above restores the defaults the scenarios below depend on. Exit
# nonzero so that a leaked hook variable cannot turn this suite into a pass.
if [ -n "${AUTOLINT_CANCEL_HEADER_ONLY:-}" ]; then
  printf 'ignored=%s\n' "$_ignored_signals"
  exit 3
fi

CHECKRUN_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
CHECKRUN_TEST_ROOT="$(cd -- "$CHECKRUN_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$CHECKRUN_TEST_DIR/helpers.sh"

_require_compatible_libc "autolint-cancellation-test"

# This suite wraps the host tools so it can inject failures while preserving
# their real process semantics. Minimal containers may omit procps entirely;
# skip there instead of passing Python a non-string environment value and
# misreporting every scenario as a product failure.
for _required_tool in ps mktemp mkdir rm; do
  if ! command -v "$_required_tool" >/dev/null 2>&1; then
    echo "SKIP: autolint-cancellation-test (requires $_required_tool)"
    exit 0
  fi
done
unset _required_tool

echo "=== Parallel autolint lifecycle ==="

_fixture_root=$(_tmpdir)
_tool_bin="$_fixture_root/bin"
mkdir -p "$_tool_bin"

cat >"$_tool_bin/yq" <<'SH'
#!/usr/bin/env bash
exit 0
SH
cat >"$_tool_bin/typos" <<'SH'
#!/usr/bin/env bash
exit 0
SH
cat >"$_tool_bin/ps" <<'SH'
#!/usr/bin/env bash
pgid_list=""
if [ "$#" -eq 4 ] && [ "$1" = -o ] && [ "$2" = pid=,pgid= ] && [ "$3" = -p ]; then
  printf 'called\n' >>"$AUTOLINT_CANCEL_ROOT/combined-pgid-format-calls"
  pgid_list=$4
elif [ "$#" -eq 6 ] && [ "$1" = -o ] && [ "$2" = pid= ] &&
  [ "$3" = -o ] && [ "$4" = pgid= ] && [ "$5" = -p ]; then
  printf 'called\n' >>"$AUTOLINT_CANCEL_ROOT/pgid-snapshot-calls"
  pgid_list=$6
fi
if [ -n "$pgid_list" ]; then
  leader=${pgid_list#*,}
  case "${AUTOLINT_CANCEL_PGID_SNAPSHOT:-normal}" in
    shared)
      printf '%s %s\n' "$AUTOLINT_CANCEL_PARENT_PID" "$AUTOLINT_CANCEL_PARENT_PID"
      printf '%s %s\n' "$leader" "$AUTOLINT_CANCEL_PARENT_PID"
      exit 0
      ;;
    malformed)
      printf '%s %s\n' "$AUTOLINT_CANCEL_PARENT_PID" "$AUTOLINT_CANCEL_PARENT_PID"
      printf '%s invalid\n' "$leader"
      exit 0
      ;;
  esac
  exec "$AUTOLINT_CANCEL_REAL_PS" "$@"
fi
if [ "$#" -eq 4 ] && [ "$1" = -o ] && [ "$2" = pgid= ] && [ "$3" = -p ]; then
  printf 'called\n' >>"$AUTOLINT_CANCEL_ROOT/legacy-pgid-calls"
  exec "$AUTOLINT_CANCEL_REAL_PS" "$@"
fi
if [ "$#" -eq 4 ] && [ "$1" = -o ] && [ "$2" = ppid= ] && [ "$3" = -p ]; then
  # The cancellation anchor verifies its exact parent-child relationship on
  # ps-only hosts. This targeted identity read is not a liveness-table scan.
  exec "$AUTOLINT_CANCEL_REAL_PS" "$@"
fi
printf 'called\n' >>"$AUTOLINT_CANCEL_ROOT/ps-calls"
exec "$AUTOLINT_CANCEL_REAL_PS" "$@"
SH
cat >"$_tool_bin/slow-planner" <<'PY'
#!/usr/bin/env python3
import os
from pathlib import Path
import signal
import time


root = Path(os.environ["AUTOLINT_CANCEL_ROOT"])
(root / "planner.pid").write_text(str(os.getpid()), encoding="ascii")
group = os.getpgrp()
if group != int(os.environ["AUTOLINT_CANCEL_PARENT_PID"]):
    (root / "supervisor.pid").write_text(str(group), encoding="ascii")


def terminate(_signum, _frame):
    (root / "planner.term").touch(exist_ok=True)
    raise SystemExit(143)


signal.signal(signal.SIGTERM, terminate)
(root / "planner.ready").touch(exist_ok=False)
# This is the foreground work a cancellation must not wait for. It ends only
# when the harness releases it, which it does only after a cancellation has
# already failed to finish promptly, so waiting for it is unambiguous.
deadline = time.monotonic() + 60
while not (root / "foreground.release").exists() and time.monotonic() < deadline:
    time.sleep(0.01)
PY
cat >"$_tool_bin/shellcheck" <<'PY'
#!/usr/bin/env python3
import os
from pathlib import Path
import signal
import sys
import time


root = Path(os.environ["AUTOLINT_CANCEL_ROOT"])
source = Path(sys.argv[-1])
index = source.stem.rsplit("-", 1)[-1]
(root / f"backend-{index}.pid").write_text(str(os.getpid()), encoding="ascii")
(root / f"worker-{index}.pid").write_text(str(os.getppid()), encoding="ascii")
group = os.getpgrp()
if group != int(os.environ["AUTOLINT_CANCEL_PARENT_PID"]):
    try:
        with (root / "supervisor.pid").open("x", encoding="ascii") as stream:
            stream.write(str(group))
    except FileExistsError:
        pass


def grace_polls():
    try:
        events = (root / "parent-events").read_text(encoding="ascii").splitlines()
    except OSError:
        return 0
    return events.count("poll")


def terminate(_signum, _frame):
    (root / f"backend-{index}.term").touch(exist_ok=True)
    if os.environ.get("AUTOLINT_CANCEL_IGNORE_TERM") == "1":
        return
    if os.environ.get("AUTOLINT_CANCEL_TERM_CLEANUP") == "1":
        # Model a linter that needs part of the parent's cancellation grace to
        # clean up. Measure that grace in the parent's own polls, not wall
        # time: an immediate KILL ends this before the third poll, while a real
        # grace allows twenty.
        deadline = time.monotonic() + 10
        while grace_polls() < 3 and time.monotonic() < deadline:
            time.sleep(0.002)
        (root / f"backend-{index}.cleaned").touch(exist_ok=True)
    raise SystemExit(143)


signal.signal(signal.SIGTERM, terminate)
gate_fd = os.open(root / f"gate-{index}", os.O_RDONLY | os.O_NONBLOCK)
try:
    # Readiness means the TERM handler is installed and a FIFO reader exists;
    # the harness can now signal or release without racing backend startup.
    (root / f"backend-{index}.ready").touch(exist_ok=False)
    while True:
        try:
            released = os.read(gate_fd, 1)
        except BlockingIOError:
            released = b""
        if released:
            break
        time.sleep(0.005)
finally:
    os.close(gate_fd)

print(f"backend:{index}", flush=True)
with (root / "backend-completion-order").open("a", encoding="ascii") as stream:
    stream.write(f"{index}\n")
(root / f"backend-{index}.done").touch(exist_ok=False)
raise SystemExit(int(os.environ.get(f"AUTOLINT_CANCEL_EXIT_{index}", "0")))
PY
chmod +x "$_tool_bin/yq" "$_tool_bin/typos" "$_tool_bin/ps" \
  "$_tool_bin/slow-planner" "$_tool_bin/shellcheck"

_driver="$_fixture_root/driver"
cat >"$_driver" <<'SH'
#!/usr/bin/env bash
set -u

impl=$1
root=$2
mode=$3
count=$4
jobs=$5

mkdir -p "$root/tmp"
export TMPDIR="$root/tmp"
export CHECKRUN_CONFIG_DIR=/nonexistent
export CHECKRUN_AUTOLINT_JOBS="$jobs"
export AUTOLINT_CANCEL_ROOT="$root"
export AUTOLINT_CANCEL_PARENT_PID=${BASHPID:-$$}

# shellcheck source=/dev/null
. "$impl"

# Record, in order, every pause the parent itself takes and every group
# signal, so the harness can check how cancellation escalates without
# measuring wall time. Bash 3.2 has no BASHPID to tell the parent from a
# subshell, so it records no pauses there; only the parent signals a group.
sleep() {
  if [ -n "${BASHPID:-}" ] && [ "$BASHPID" = "$AUTOLINT_CANCEL_PARENT_PID" ]; then
    printf 'pause %s\n' "$1" >>"$root/parent-events"
  fi
  command sleep "$@"
}
kill() {
  local owned owned_pid attempt pending
  case "${2:-}" in
    -[1-9]*) printf 'kill %s %s\n' "$1" "$2" >>"$root/parent-events" ;;
  esac
  if { [ "$mode" = normal ] || [ "$mode" = planner-signal ]; } &&
    [ "${1:-}" = -KILL ] && [[ "${2:-}" == -[1-9]* ]]; then
    # The parent KILLs the group once the supervisor has reaped its workers,
    # which outlive TERM only until their linter exits, or after its 200 ms
    # grace, which a starved backend or planner can miss entirely. Hold the
    # KILL, boundedly, until each one has observed the TERM or is gone, so
    # the harness can require cooperative delivery on any host. This only
    # delays KILL: a TERM that never reached them still fails. It also means
    # these cases no longer see whether a grace exists at all; the
    # escalation check below drives the real loop for that.
    for ((attempt = 0; attempt < 500; attempt++)); do
      pending=0
      for owned in "$root"/backend-*.pid "$root/planner.pid"; do
        [ -e "$owned" ] || continue
        [ ! -e "${owned%.pid}.term" ] || continue
        # The PID file has no trailing newline, so `read` reports EOF.
        owned_pid=""
        IFS= read -r owned_pid <"$owned" 2>/dev/null
        [ -n "$owned_pid" ] || continue
        if builtin kill -0 "$owned_pid" 2>/dev/null; then
          pending=1
          break
        fi
      done
      [ "$pending" -eq 1 ] || break
      command sleep 0.01
    done
    printf 'held %s\n' "$attempt" >>"$root/parent-events"
  fi
  builtin kill "$@"
}
# Record each poll of the parent's cancellation grace, which checks whether the
# supervisor has quiesced, so a fixture can measure the grace in polls on any
# Bash.
_autolint_real_supervisor_quiesced=$(declare -f _autolint_supervisor_quiesced)
eval "_autolint_real_supervisor_quiesced${_autolint_real_supervisor_quiesced#_autolint_supervisor_quiesced}"
_autolint_supervisor_quiesced() {
  printf 'poll\n' >>"$root/parent-events"
  _autolint_real_supervisor_quiesced "$@"
}

case "$mode" in
  capability-fallback)
    command() {
      if [ "${1:-}" = -v ] && [ "${2:-}" = ps ]; then
        return 1
      fi
      builtin command "$@"
    }
    _autolint_read_proc_group() { return 1; }
    ps() { return 127; }
    ;;
  allocation-fallback)
    mktemp() {
      if [ "${1:-}" = -d ]; then
        return 1
      fi
      "$AUTOLINT_CANCEL_REAL_MKTEMP" "$@"
    }
    ;;
  allocation-fallback-signal)
    mktemp() {
      if [ "${1:-}" = -d ]; then
        return 1
      fi
      "$AUTOLINT_CANCEL_REAL_MKTEMP" "$@"
    }
    ;;
  capability-fallback-signal)
    command() {
      if [ "${1:-}" = -v ] && [ "${2:-}" = ps ]; then
        return 1
      fi
      builtin command "$@"
    }
    _autolint_read_proc_group() { return 1; }
    ps() { return 127; }
    ;;
  allocation-signal)
    mktemp() {
      local rc
      "$AUTOLINT_CANCEL_REAL_MKTEMP" "$@"
      rc=$?
      kill -TERM "$AUTOLINT_CANCEL_PARENT_PID"
      return "$rc"
    }
    ;;
  cleanup-signal)
    rm() {
      local rc
      "$AUTOLINT_CANCEL_REAL_RM" "$@"
      rc=$?
      if [ "${1:-}" = -rf ] && [ ! -e "$root/cleanup-signalled" ]; then
        : >"$root/cleanup-signalled"
        kill -TERM "$AUTOLINT_CANCEL_PARENT_PID"
      fi
      return "$rc"
    }
    ;;
  cleanup-group-signal)
    _autolint_cleanup_attempt=0
    rm() {
      local rc cleanup_child cleanup_attempt
      if [ "${1:-}" = -rf ]; then
        _autolint_cleanup_attempt=$((_autolint_cleanup_attempt + 1))
        printf '%s\n' "$_autolint_cleanup_attempt" >>"$root/cleanup-attempts"
        if [ "$_autolint_cleanup_attempt" -eq 1 ]; then
          # Give the harness a live child wait to interrupt with a terminal-group
          # signal. A fast real rm would not prove that active cleanup returns
          # the signal status which drives the managed retry. `command` skips
          # the driver's pause recorder so that the child itself runs sleep.
          command sleep 30 &
          cleanup_child=$!
          printf '%s\n' "$cleanup_child" >"$root/cleanup-child.pid"
          # Publish readiness only once the child runs sleep itself. A group
          # TERM between fork and exec reaches Bash's inherited trap handler
          # and is lost, and the surviving sleep then holds the harness pipes.
          for ((cleanup_attempt = 0; cleanup_attempt < 500; cleanup_attempt++)); do
            case "$(LC_ALL=C "$AUTOLINT_CANCEL_REAL_PS" -o comm= -p "$cleanup_child" 2>/dev/null)" in
              *sleep*) break ;;
            esac
            sleep 0.01
          done
          : >"$root/cleanup-ready"
          if wait "$cleanup_child"; then
            rc=0
          else
            rc=$?
          fi
          printf '%s\n' "$rc" >"$root/cleanup-first-status"
          return "$rc"
        fi
      fi
      "$AUTOLINT_CANCEL_REAL_RM" "$@"
    }
    ;;
  cleanup-retry-signal)
    _autolint_cleanup_attempt=0
    rm() {
      if [ "${1:-}" = -rf ]; then
        _autolint_cleanup_attempt=$((_autolint_cleanup_attempt + 1))
        printf '%s\n' "$_autolint_cleanup_attempt" >>"$root/cleanup-attempts"
        if [ "$_autolint_cleanup_attempt" -eq 1 ]; then
          return 73
        fi
        if [ "$_autolint_cleanup_attempt" -eq 2 ]; then
          # Publish readiness only from inside the retry, then hold until the
          # managed handler records TERM. This pins the signal to the retry
          # window instead of merely observing it before or after cleanup.
          : >"$root/cleanup-retry-ready"
          while [ "${_autolint_signal_status:-0}" -eq 0 ]; do
            sleep 0.01
          done
          return "$_autolint_signal_status"
        fi
      fi
      "$AUTOLINT_CANCEL_REAL_RM" "$@"
    }
    ;;
  cleanup-failure | cleanup-failure-errexit)
    _autolint_cleanup_attempt=0
    rm() {
      if [ "${1:-}" = -rf ]; then
        _autolint_cleanup_attempt=$((_autolint_cleanup_attempt + 1))
        printf '%s\n' "$_autolint_cleanup_attempt" >>"$root/cleanup-attempts"
        return 73
      fi
      "$AUTOLINT_CANCEL_REAL_RM" "$@"
    }
    ;;
  validation-cleanup-failure)
    _autolint_failed_cleanup_dir=""
    _autolint_cleanup_attempt=0
    _autolint_validate_private_group() { return 1; }
    rm() {
      if [ "${1:-}" = -rf ]; then
        if [ -z "$_autolint_failed_cleanup_dir" ]; then
          _autolint_failed_cleanup_dir=${2:-}
        fi
        if [ "${2:-}" = "$_autolint_failed_cleanup_dir" ]; then
          _autolint_cleanup_attempt=$((_autolint_cleanup_attempt + 1))
          printf '%s\n' "$_autolint_cleanup_attempt" >>"$root/cleanup-attempts"
          return 73
        fi
      fi
      "$AUTOLINT_CANCEL_REAL_RM" "$@"
    }
    ;;
  gate-failure)
    # Exercise the same targeted-ps validation path used on hosts without
    # procfs; the injected gate failure occurs only after that validation.
    _autolint_read_proc_group() { return 1; }
    mkdir() {
      local arg
      for arg in "$@"; do
        case "$arg" in
          */.supervisor/gate)
            : >"$root/gate-release-attempted"
            return 73
            ;;
        esac
      done
      "$AUTOLINT_CANCEL_REAL_MKDIR" "$@"
    }
    kill() {
      case "${1:-}:${2:-}" in
        -TERM:-* | -KILL:-*)
          : >"$root/gate-group-signal"
          ;;
        -TERM:[1-9]*)
          : >"$root/gate-direct-stop"
          ;;
      esac
      builtin kill "$@"
    }
    ;;
  gate-visible-failure | gate-visible-failure-signal)
    _autolint_read_proc_group() { return 1; }
    _autolint_pre_plan() {
      printf 'x\n' >"$1/0.plan"
      printf 'x\n' >"$1/1.plan"
    }
    _autolint_try_clean_batch() { return 1; }
    _lint_one_with_plan() {
      local index=${1##*/}
      index=${index%.plan}
      # Each worker gets its own files. With a shared PID file, the mkdir
      # wrapper could read it between the second worker's truncation and
      # its write, and record an empty supervisor group.
      printf '%s\n' "${BASHPID:-$$}" >"$root/gate-visible-worker-$index.pid"
      : >"$root/gate-visible-worker-$index.ready"
      if [ "$mode" = gate-visible-failure-signal ]; then
        trap '' TERM
      fi
      sleep 30
    }
    mkdir() {
      local arg rc worker group ready
      "$AUTOLINT_CANCEL_REAL_MKDIR" "$@"
      rc=$?
      for arg in "$@"; do
        case "$arg" in
          */.supervisor/gate)
            # The real mkdir above creates the gate; wait until authorized work
            # is visible before returning failure. This models mkdir succeeding at the
            # filesystem boundary but reporting interruption, where exact-PID
            # cleanup would miss descendants and the validated group must win.
            # A worker's ready marker follows its complete PID file.
            while :; do
              for ready in "$root"/gate-visible-worker-*.ready; do
                [ -e "$ready" ] && break 2
              done
              sleep 0.01
            done
            IFS= read -r worker <"${ready%.ready}.pid"
            group=$(LC_ALL=C "$AUTOLINT_CANCEL_REAL_PS" -o pgid= -p "$worker")
            group=${group//[[:space:]]/}
            printf '%s\n' "$group" >"$root/supervisor.pid"
            : >"$root/gate-visible-release-attempted"
            return 73
            ;;
        esac
      done
      return "$rc"
    }
    kill() {
      case "${1:-}:${2:-}" in
        -TERM:-*)
          : >"$root/gate-visible-group-signal"
          [ "$mode" != gate-visible-failure-signal ] || \
            : >"$root/gate-visible-cancel-started"
          ;;
        -KILL:-*) : >"$root/gate-visible-group-signal" ;;
      esac
      builtin kill "$@"
    }
    ;;
  leader-marker-failure)
    mkdir() {
      local arg rc
      "$AUTOLINT_CANCEL_REAL_MKDIR" "$@"
      rc=$?
      for arg in "$@"; do
        case "$arg" in
          */.supervisor)
            # Permission bits are not a deterministic write-failure injection:
            # root inside a container can bypass a mode-500 directory. A
            # directory at the marker pathname rejects redirection on every
            # supported host while leaving the control root removable.
            "$AUTOLINT_CANCEL_REAL_MKDIR" "$arg/leader" || return $?
            ;;
        esac
      done
      return "$rc"
    }
    ;;
  anchor-mismatch)
    ;;
  monitor)
    set -m
    _autolint_pre_plan() {
      printf 'x\n' >"$1/0.plan"
      printf 'x\n' >"$1/1.plan"
    }
    _autolint_try_clean_batch() { return 1; }
    _lint_one_with_plan() { :; }
    mkdir() {
      local arg rc
      "$AUTOLINT_CANCEL_REAL_MKDIR" "$@"
      rc=$?
      for arg in "$@"; do
        case "$arg" in
          # The real mkdir already released the child. Hold the parent here so
          # a fast supervisor can finish while notifications are disabled;
          # restoring monitor mode later must not emit a stale job message.
          */.supervisor/gate) sleep 0.1 ;;
        esac
      done
      return "$rc"
    }
    ;;
  pre-wait-signal)
    _autolint_poll_signal_sent=0
    _autolint_read_status_file() {
      if [ "${BASH_SUBSHELL:-0}" -eq 0 ] &&
        [ "$_autolint_poll_signal_sent" -eq 0 ] &&
        [[ "$1" == */.supervisor/exited ]]; then
        # Inject immediately after the parent's latch check, at its first owned
        # event probe. This retains the former pre-wait race coverage now that
        # the implementation deliberately avoids a blocking wait on a live
        # cancellation anchor.
        _autolint_poll_signal_sent=1
        : >"$root/pre-wait-signal"
        kill -TERM "$AUTOLINT_CANCEL_PARENT_PID"
      fi
      return 1
    }
    ;;
  restore-signal)
    _autolint_restore_signal_traps() {
      local saved_hup="$1" saved_int="$2" saved_term="$3"
      if [ ! -e "$root/restore-signal" ]; then
        # Inject before evaluating the saved handlers. The managed TERM trap must
        # still own this boundary so the operation records cancellation instead
        # of invoking the caller trap halfway through restoration.
        : >"$root/restore-signal"
        kill -TERM "$AUTOLINT_CANCEL_PARENT_PID"
      fi
      eval "${saved_hup:-trap - HUP}"
      eval "${saved_int:-trap - INT}"
      eval "${saved_term:-trap - TERM}"
    }
    ;;
  planner-signal)
    _autolint_pre_plan() { slow-planner; }
    ;;
  direct-one-signal)
    _autolint_pre_plan() { slow-planner; }
    ;;
  validation-fallback | validation-fallback-signal)
    _autolint_validate_private_group() { return 1; }
    ;;
  shared-pgid)
    _autolint_read_proc_group() { return 1; }
    ;;
  malformed-pgid)
    _autolint_read_proc_group() { return 1; }
    ;;
  ps-pgid-success)
    _autolint_read_proc_group() { return 1; }
    ;;
  repeat)
    kill() {
      local group attempt
      if [ "${1:-}" = -KILL ] && [[ "${2:-}" == -[1-9]* ]]; then
        group=${2#-}
        if builtin kill -0 "$group" 2>/dev/null; then
          : >"$root/group-kill-anchored"
        fi
        # The repeat scenario must inject its second signal after production has
        # frozen terminal-signal traps but before exact cleanup restores the
        # caller's traps. Fast hosts can otherwise finish KILL plus wait before
        # the Python driver runs again, turning the test into a post-operation
        # signal that correctly invokes the caller's restored HUP trap. Publish
        # this exact escalation boundary and hold it until the driver sends HUP.
        # Keep the wait bounded so a broken driver cannot strand this fixture.
        : >"$root/repeat-cleanup-frozen"
        for ((attempt = 0; attempt < 500; attempt++)); do
          [ -e "$root/repeat-second-signal-sent" ] && break
          sleep 0.01
        done
      fi
      builtin kill "$@"
    }
    ;;
  wave | grace-wave)
    _autolint_supports_pool() { return 1; }
    ;;
  normal-no-probe)
    # Failure-composition scenarios use single-shot FIFO backends that cannot
    # run twice. The speculative probe plus authoritative fallback would
    # execute them once each; stub the probe so these cases keep testing the
    # pool's status merge and ordered replay. Probe composition itself is
    # covered by autolint-test with re-runnable mocks.
    _autolint_try_clean_batch() { return 1; }
    ;;
esac

case "$mode" in
  capability-fallback | validation-fallback | validation-cleanup-failure | \
    shared-pgid | malformed-pgid | gate-failure)
