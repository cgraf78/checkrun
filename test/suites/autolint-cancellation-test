        # waits for or cancels the supervisor must stay at the 10 ms poll.
        pauses = [event[1] for event in parent_events() if event[0] == "pause"]
        long_pauses = [pause for pause in pauses if float(pause) > 0.01]
        if long_pauses:
            raise RuntimeError(f"parent paused longer than 10 ms: {long_pauses!r}")

    if not direct_signal and scenario not in (
        "allocation-fallback-signal", "allocation-signal", "anchor-hold",
        "anchor-mismatch", "gate-visible-failure", "gate-visible-failure-signal",
        "monitor", "planner-signal",
        "direct-one-signal", "direct-jobs-one-signal", "pre-wait-signal", "signal", "repeat",
        *GRACE_SCENARIOS,
