    [shell, driver, impl, str(root), mode, str(count), str(jobs)],
    env=env,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
    start_new_session=True,
)
unrelated = subprocess.Popen(
    [sys.executable, "-c", "import signal; signal.pause()"],
    start_new_session=True,
)


def process_state(pid):
    result = subprocess.run(
        ["ps", "-o", "stat=", "-p", str(pid)],
        check=False,
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def process_state_is_live(state):
    # Backends are grandchildren of the Bash supervisor. If a group kill ends
    # a worker and its backend together, the dead backend can be adopted by the
    # container's PID 1; how quickly that init reaps Z/X entries is outside
    # Checkrun's control. Those states cannot execute work, so lifecycle checks
    # reject live descendants without depending on host-specific init policy.
    return bool(state) and not state.startswith(("Z", "X"))


def alive(pid):
    return process_state_is_live(process_state(pid))


def observed_paths():
    # A failed wait reports what the fixture published, which tells startup
    # that is merely slow apart from a path that never started (for example,
    # a sequential fallback that will not start the second backend).
    paths = []
    try:
        for path in root.rglob("*"):
            paths.append(str(path.relative_to(root)))
    except OSError:
        pass
    return sorted(paths)


def driver_exit_status():
    # Peek without reaping. Reaping here would free the driver's PID while a
    # later step may still signal it, and `Popen` can still collect it.
    if not hasattr(os, "waitid"):
        # Without a non-reaping probe, rely on the deadline alone.
        return None
    try:
        info = os.waitid(
            os.P_PID, process.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT
        )
    except ChildProcessError:
        return process.returncode
    return None if info is None else info.si_status


def wait_for(predicate, description, seconds=20):
    # These waits are preconditions, not latency assertions; cancellation
    # promptness is asserted separately by `await_cancellation`. Reaching a
    # marker can take several interpreter startups, which took about 5 s at a
    # load average of 4x the CPU count and has exceeded the former 6 s bound.
    # Bound a real hang generously instead, and fail at once when the driver
    # exits: every marker comes from the driver or a descendant it is still
    # waiting for, so none can appear after that.
    deadline = time.monotonic() + seconds
    while True:
        if predicate():
            return
        status = driver_exit_status()
        if status is not None:
            if predicate():
                return
            raise RuntimeError(
                f"driver exited {status} before {description}; "
                f"observed {observed_paths()!r}"
            )
        if time.monotonic() >= deadline:
            raise RuntimeError(
                f"timed out after {seconds} s waiting for {description}; "
                f"observed {observed_paths()!r}"
            )
        time.sleep(0.02)


def release(index):
    with (root / f"gate-{index}").open("wb", buffering=0) as gate:
        gate.write(b"x")


def parent_events():
    # ("pause", seconds) and ("kill", signal, target) records from the driver.
    path = root / "parent-events"
    if not path.exists():
        return []
    return [tuple(line.split()) for line in path.read_text(encoding="ascii").splitlines()]


def release_if_waiting(index):
    # A cancelled backend may already be gone, and opening a FIFO with no
    # reader would block, so release only a backend that still waits.
    try:
        gate = os.open(root / f"gate-{index}", os.O_WRONLY | os.O_NONBLOCK)
    except OSError:
        return
    try:
        os.write(gate, b"x")
    except OSError:
        pass
    finally:
        os.close(gate)


# Cancellation must not wait for the foreground work that is running when the
# signal arrives. Asserting that as wall time (formerly 0.8 s from the signal)
# failed on slow and loaded hosts even though the bounded cancellation path,
# whose escalation alone polls for 200 ms before KILL, was working: at a load
# average of about 250 it took up to 0.9 s, measured without harness overhead.
# Assert the ordering instead. The foreground work in these scenarios (the
# slow planner, a backend, the direct-fallback probe) never finishes on its
# own; the harness releases it only after this delay, so a cancellation that
# ends later than that provably waited for it, while a merely slow one
# passes. Passing runs never pay the delay. How finely the parent polls is
# checked separately from recorded pauses, which load cannot stretch.
FOREGROUND_RELEASE_DELAY = 5
RELEASABLE_FOREGROUND = (
    "allocation-fallback-signal", "capability-fallback-signal",
    "validation-fallback-signal", "planner-signal", "pre-wait-signal",
    "direct-one-signal", "direct-jobs-one-signal",
)


def release_foreground():
    (root / "foreground.release").touch()
    for index in range(count):
        release_if_waiting(index)


def await_cancellation(description, started):
    """Wait for the driver after a cancellation signal, failing if it waited
    for the foreground work or did not finish at all."""
    try:
        process.wait(timeout=FOREGROUND_RELEASE_DELAY)
        return
    except subprocess.TimeoutExpired:
        pass
    releasable = scenario in RELEASABLE_FOREGROUND
    if releasable:
        release_foreground()
    try:
        process.wait(timeout=8)
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(f"{description} did not finish") from error
    elapsed = time.monotonic() - started
    if releasable:
        raise RuntimeError(
            f"{description} waited for foreground work: it finished "
            f"{elapsed:.1f} s after the signal, only once that work was released "
            f"after {FOREGROUND_RELEASE_DELAY} s"
        )
    raise RuntimeError(
        f"{description} took {elapsed:.1f} s after the signal "
        f"(limit {FOREGROUND_RELEASE_DELAY} s)"
    )


def read_pid(path):
    # A worker killed by group cancellation between creating its PID file and
    # writing it leaves the file empty; it has nothing left to clean up.
    text = path.read_text(encoding="ascii").strip()
    return int(text) if text else None


def extra_pid_paths():
    paths = [root / "anchor.pid", *sorted(root.glob("gate-visible-worker-*.pid"))]
    return [path for path in paths if path.is_file()]


def backend_finished(index):
    pid_path = root / f"backend-{index}.pid"
    if not (root / f"backend-{index}.done").is_file() or not pid_path.is_file():
        return False
    return not alive(int(pid_path.read_text(encoding="ascii")))


backend_pids = []
worker_pids = []
errors = []
signal_time = None
