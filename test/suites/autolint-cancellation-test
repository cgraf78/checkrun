        release(0)
    else:
        wait_for(
            lambda: all((root / f"backend-{index}.ready").is_file() for index in range(count)),
            "all parallel backends",
        )
        if scenario == "grace-group-signal":
            # Signal the private group directly, so the parent learns of the
