_assert_eq "pre-gate TERM is latched by the supervisor's handler" "143" \
  "$(cat "$_pgid_case_root/exited" 2>/dev/null)"
_run_pgid_case "gate opens only after the supervisor is armed" \
  slow-arming-gate 0
_assert_file_missing "gate stays closed until the supervisor is armed" \
  "$_pgid_case_root/gate-before-armed"
_run_pgid_case "lost job listing is an inspection failure, not an exit" \
