        # The parent must signal the group cooperatively before any KILL. The
        # driver holds that KILL until each backend, already in its TERM-ready
        # wait, has observed the TERM, so a missing observation means the TERM
        # never reached it, not that a loaded host starved its handler.
        group_signals = [event[1] for event in parent_events() if event[0] == "kill"]
        if not group_signals or group_signals[0] != "-TERM":
            raise RuntimeError(f"group signals {group_signals!r} did not start with TERM")
    unobserved = [
        index for index in range(count) if not (root / f"backend-{index}.term").is_file()
    ]
    if scenario in GRACE_SCENARIOS:
        # The parent TERMs the group, then polls for up to 20 grace checks
        # before it KILLs. Workers outlive TERM until their linter exits, so
        # a linter that cleans up within the grace finishes, and one that
        # ignores TERM holds the supervisor until the KILL ends the grace.
        events = parent_events()
        group_signals = [event[1] for event in events if event[0] == "kill"]
        if not group_signals or group_signals[0] != "-TERM":
            raise RuntimeError(f"group signals {group_signals!r} did not start with TERM")
        term_at = next(i for i, e in enumerate(events) if e[:2] == ("kill", "-TERM"))
        polls = [event for event in events[term_at:] if event == ("poll",)]
        kill_at = next(
            (i for i, e in enumerate(events) if e[:2] == ("kill", "-KILL")), None
        )
        if scenario in ("grace-cleanup", "grace-cleanup-wave"):
            uncleaned = [
                index for index in range(count)
                if not (root / f"backend-{index}.cleaned").is_file()
            ]
            if uncleaned:
                raise RuntimeError(
                    f"backends {uncleaned!r} were stopped before cleaning up "
                    f"within the grace; parent polled {len(polls)} times"
                )
        else:
            grace = [e for e in events[term_at:kill_at] if e == ("poll",)] \
                if kill_at is not None else []
            if kill_at is None or len(grace) != 20:
                raise RuntimeError(
                    f"stubborn backends were KILLed after {len(grace)} grace polls, "
                    "expected the full 20"
                )
    if scenario in ("signal", "repeat") and unobserved:
        raise RuntimeError(
            f"owned backends {unobserved!r} did not observe cooperative TERM; "
            f"group signals and KILL hold {[e for e in parent_events() if e[0] != 'pause']!r}"
        )
    if scenario == "planner-signal" and not (root / "planner.term").is_file():
        raise RuntimeError("owned registry planner did not observe TERM")
    if not alive(unrelated.pid):
        raise RuntimeError("unrelated process was signalled")
except BaseException as error:
    errors.append(str(error))
finally:
    if process.poll() is None:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    for pid_file in root.glob("backend-*.pid"):
        pid = int(pid_file.read_text(encoding="ascii"))
        if alive(pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    supervisor_file = root / "supervisor.pid"
    if scenario == "gate-visible-failure" and supervisor_file.exists():
        supervisor_group = int(supervisor_file.read_text(encoding="ascii"))
        try:
            os.killpg(supervisor_group, signal.SIGKILL)
        except ProcessLookupError:
            pass
    for extra_pid_path in extra_pid_paths():
        pid = read_pid(extra_pid_path)
        if pid is not None and alive(pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    planner_pid_file = root / "planner.pid"
    if planner_pid_file.exists():
        planner_pid = int(planner_pid_file.read_text(encoding="ascii"))
        if alive(planner_pid):
            try:
                os.kill(planner_pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    process.wait()
    if unrelated.poll() is None:
        unrelated.kill()
    unrelated.wait()

if errors:
    print("; ".join(errors), file=sys.stderr)
    raise SystemExit(1)
