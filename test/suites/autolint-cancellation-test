}

# The supervisor's work is irrelevant to identity; a visible marker proves
# whether the gate ever authorized it.
_autolint_run_read_only_pipeline() {
  : >"$root/work-started"
  case "$scenario" in
    completion-race) sleep 0.1 ;;
    jobs-false-exit-after-gate) sleep 0.3 ;;
  esac
  return 0
}

