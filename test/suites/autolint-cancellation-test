_run_case() {
  local description="$1" scenario="$2" signal_name="${3:-TERM}" signal_label root
  signal_label=$(printf '%s\n' "$signal_name" | tr '[:upper:]' '[:lower:]')
  root="$_fixture_root/case-$scenario-$signal_label-$RANDOM"
  if "$_harness" "$BASH" "$_driver" "$CHECKRUN_TEST_ROOT/lib/checkrun/autolint.sh" \
    "$_tool_bin" "$root" "$scenario" "$signal_name"; then
    _pass "$description"
  else
    _fail "$description"
  fi
}

echo "=== Manifest planning cancellation boundary ==="

_manifest_cancel_dir=$(mktemp -d "${TMPDIR:-/tmp}/autolint-cancel-manifest.XXXXXX")
_manifest_cancel_marker="$_manifest_cancel_dir/registry-started"
set +e
(
  CHECKRUN_LIB_DIR="$CHECKRUN_TEST_ROOT/lib/checkrun"
  # shellcheck source=../../lib/checkrun/autolint.sh
  . "$CHECKRUN_LIB_DIR/autolint.sh"
  _autolint_signal_status=0
  _autolint_cancel_status=0
  # shellcheck disable=SC2329 # Invoked indirectly by the sourced planner.
  printf() {
    if [ "${1:-}" = '%s\0' ]; then
      _autolint_record_signal 143
    fi
    # shellcheck disable=SC2059 # This shim must preserve the exact format.
    builtin printf "$@"
  }
  # shellcheck disable=SC2329 # Invoked indirectly by the sourced planner.
  _checkrun_registry() {
    : >"$_manifest_cancel_marker"
  }
  files=()
  for ((index = 0; index < 257; index++)); do
    files+=("file-$index.sh")
  done
  _autolint_pre_plan "$_manifest_cancel_dir" "${files[@]}"
)
_manifest_cancel_rc=$?
set -e
_assert_exit "manifest cancellation: latched TERM is returned" 143 \
  "$_manifest_cancel_rc"
_assert_file_missing "manifest cancellation: no later planner starts" \
  "$_manifest_cancel_marker"
rm -rf "$_manifest_cancel_dir"

_run_case "no-op hot path stays direct" no-op
_run_case "allocation failure restores traps and falls back sequentially" \
  allocation-fallback
_run_case "allocation fallback latches TERM and launches no later work" \
  allocation-fallback-signal
_run_case "capability fallback restores direct TERM behavior" \
  capability-fallback-signal
_run_case "allocation-time signal returns after exact cleanup" allocation-signal
_run_case "cleanup-time signal remains the operation result" cleanup-signal
_run_case "terminal-group TERM retries an interrupted cleanup" cleanup-group-signal
_run_case "TERM during cleanup retry is latched and cleanup completes" \
  cleanup-retry-signal
_run_case "permanent cleanup failure is reported" cleanup-failure
_run_case "set -e caller restores state before cleanup failure returns" \
  cleanup-failure-errexit
_run_case "cleanup failure does not skip validation fallback lint" \
  validation-cleanup-failure
_run_case "missing cancellation tool falls back sequentially" capability-fallback
_run_case "failed gate release stops and reaps only the gated leader" gate-failure
_run_case "visible gate after mkdir failure cancels the validated group" \
  gate-visible-failure
_run_case "first TERM during visible-gate cleanup remains latched" \
  gate-visible-failure-signal
_run_case "stopped parent retains the exact private-group anchor" anchor-hold
_run_case "anchor never signals a definitively mismatched parent" anchor-mismatch
_run_case "leader marker failure restores monitor-off caller state" \
  leader-marker-failure
_run_case "monitor-on caller gets no job notification" monitor
_run_case "parent-only TERM cancels the registry planner promptly" planner-signal
_run_case "TERM immediately before leader wait cancels promptly" pre-wait-signal
_run_case "TERM during trap restoration remains the operation result" \
  restore-signal
_run_case "success restores Sley-style caller state and ordered output" success
_run_case "ordinary failure preserves status and ordered output" failure
_run_case "reverse completion preserves ordered output and strongest status" \
  precedence
_run_case "wave runner retains status and ordered output" wave
_run_case "validation failure falls back sequentially" fallback
_run_case "validation fallback restores direct TERM behavior" \
  validation-fallback-signal
_run_case "shared process group fails validation and falls back sequentially" \
  shared-pgid
_run_case "malformed process group snapshot falls back sequentially" \
  malformed-pgid
_run_case "targeted ps process-group snapshot validates successfully" \
  ps-pgid-success
_run_case "one-file hot path stays direct" one
_run_case "jobs=1 hot path stays direct" jobs-one
_run_case "parent-only TERM stays prompt during one-file planning" direct-one-signal
_run_case "parent-only TERM stays prompt during jobs=1 lint" direct-jobs-one-signal
_run_case "parent-only HUP cancels the complete backend group" signal HUP
_run_case "parent-only INT cancels the complete backend group" signal INT
_run_case "parent-only TERM cancels the complete backend group" signal TERM
_run_case "first signal wins while stubborn backends escalate" repeat TERM

set +e
# shellcheck disable=SC2016 # This program is evaluated by the selected Bash.
"$BASH" -c '
  if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3))); then
    exit 1
  fi
  (exit 7) &
  pid=$!
  wait -n 2>/dev/null
  first_rc=$?
  wait "$pid" 2>/dev/null
  second_rc=$?
  [[ "$first_rc" -eq 7 && "$second_rc" -eq 7 ]]
' >/dev/null 2>&1
_wait_n_rc=$?
set -e
if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 3))); then
  _assert_exit "wait-n status can be retained by exact PID wait" 0 "$_wait_n_rc"
else
  _assert_exit "wait-n probe rejects unsupported Bash" 1 "$_wait_n_rc"
fi

# `$$` remains the PID of the outer Bash inside a subshell, while the current
# shell is the process that owns `$!` and `jobs`. Test PID discovery directly:
# Bash 3.2 can legitimately decline monitor-mode setup in a sourced subshell,
# which is a safe sequential fallback and must not hide whether this helper
# itself identified the correct process.
set +e
# shellcheck disable=SC2016 # This program, including its nested sh probe, is evaluated by the selected Bash.
"$BASH" -c '
  . "$1"
  (
    unset BASHPID 2>/dev/null || :
    real_sh=$(type -P sh) || exit 1
    # Bash 3.2 can retain its command-substitution shell while that shell waits
    # for an external command. Model that process tree on every Bash version by
    # putting status handling after the external sh invocation. The helper must
    # identify this sourcing subshell, not the retained intermediate process.
    sh() {
      local rc
      command "$real_sh" "$@"
      rc=$?
      return "$rc"
    }
    REPLY=""
    _autolint_current_shell_pid || exit 1
    observed=$REPLY
    # Some Bash builds tail-exec a final external command, replacing this
    # subshell with `sh` before the verifier reads PPID. That changes the very
    # parent relationship under test and produces a false failure even though
    # PID discovery was correct. A background child cannot replace its parent;
    # exact wait also preserves the verifier status as the subshell result.
    "$real_sh" -c '\''[ "$PPID" = "$1" ]'\'' _ "$observed" &
    verifier=$!
    wait "$verifier"
  )
' _ "$CHECKRUN_TEST_ROOT/lib/checkrun/autolint.sh"
_current_pid_rc=$?
set -e
_assert_exit "sourced subshell identifies its actual job-control PID" \
  0 "$_current_pid_rc"

if [[ "$(uname -s)" == Darwin ]] && ((BASH_VERSINFO[0] > 3)) &&
  /bin/bash -c '((BASH_VERSINFO[0] == 3 && BASH_VERSINFO[1] == 2))'; then
  if /bin/bash "$0"; then
    _pass "macOS system Bash 3.2 passes the lifecycle suite"
  else
    _fail "macOS system Bash 3.2 passes the lifecycle suite"
  fi
fi

_test_summary
