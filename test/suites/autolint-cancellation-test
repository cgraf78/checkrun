    # must still be replaceable.
    set -C
    scenario=${scenario#noclobber-}
    ;;
esac

parent=$$
json=0
_autolint_signal_status=0
_autolint_cancel_status=0
_autolint_parallel_validated=0
trap '_autolint_record_signal 129' HUP
trap '_autolint_record_signal 130' INT
trap '_autolint_record_signal 143' TERM

kill() {
  local sig="${1:-}" target="${2:-}" attempt state
  case "$sig:$target" in
    -0:* | *:"$parent") builtin kill "$@"; return ;;
    *:-[1-9]* | *:[1-9]*) ;;
    *) builtin kill "$@"; return ;;
  esac
  for ((attempt = 0; attempt < 30; attempt++)); do
    builtin kill -0 "$target" 2>/dev/null || break
    sleep 0.01
  done
  if builtin kill -0 "$target" 2>/dev/null; then
    state=live
  else
    state=stale
  fi
  printf '%s %s %s\n' "$sig" "$target" "$state" >>"$root/signals"
  builtin kill "$@" || return
  case "$sig:$target" in
    -TERM:-*) : >"$root/group-term-sent" ;;
  esac
}

# Bash reaps an exited job asynchronously; wait (bounded) until it is gone
# from the running-job table, as the parent's own liveness checks see it.
# Read the listing from a file, as the product does: whether a command
# substitution still sees this shell's job table depends on its exact form
# (`$(builtin jobs | tr ...)` always reads empty) and on the Bash version.
_pgid_await_unlisted() {
  local attempt job found
  for ((attempt = 0; attempt < 500; attempt++)); do
    builtin jobs -pr >|"$root/await-jobs" || return 1
    found=0
    while IFS= read -r job; do
      [ "$job" != "$1" ] || found=1
    done <"$root/await-jobs"
    [ "$found" -eq 1 ] || return 0
    sleep 0.01
  done
  return 1
}

# The parent publishes the supervisor's exact PID here before the gate opens.
_pgid_leader() {
