    supervised = scenario in (
        "cleanup-signal", "cleanup-group-signal", "cleanup-failure",
        "cleanup-failure-errexit", "cleanup-retry-signal", "gate-failure",
        "gate-visible-failure", "gate-visible-failure-signal", "monitor", "planner-signal", "success",
        "failure", "precedence", "restore-signal", "wave", "signal", "repeat",
        *GRACE_SCENARIOS,
        "pre-wait-signal",
        "malformed-pgid", "shared-pgid", "ps-pgid-success",
