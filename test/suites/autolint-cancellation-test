# An anchor that cannot prove its parent link by PPID (no leader marker on
# Bash 3.2, or no procfs and no usable ps) must still release once its parent
# is dead, or a parent killed outright would leak a holding supervisor.
_run_dead_parent_anchor() {
  local mode="$1"
  (
    CHECKRUN_LIB_DIR="$CHECKRUN_TEST_ROOT/lib/checkrun"
    # shellcheck source=../../lib/checkrun/autolint.sh
    . "$CHECKRUN_LIB_DIR/autolint.sh"
    _anchor_dir=$(mktemp -d "${TMPDIR:-/tmp}/autolint-anchor.XXXXXX") || exit 1
    printf '1\n' >"$_anchor_dir/hold"
    printf '%s\n' "$$" >"$_anchor_dir/leader"
    sh -c 'exit 0' &
    _dead_parent=$!
    wait "$_dead_parent"
    _autolint_cancel_status=143
    (
      case "$mode" in
        no-leader)
          # Bash 3.2 has no BASHPID, which is when the leader marker matters.
          unset BASHPID 2>/dev/null || :
          command rm -f "$_anchor_dir/leader"
          ;;
        no-ppid)
          # shellcheck disable=SC2329 # Invoked by the sourced hold loop.
          _autolint_read_process_parent() { return 1; }
          ;;
      esac
      _autolint_finish_parallel_supervisor "$_dead_parent" "$_anchor_dir/busy" \
        "$_anchor_dir/hold" "$_anchor_dir/exited" "$_anchor_dir/leader"
    ) &
    _anchor=$!
    _anchor_rc=1
    for ((_attempt = 0; _attempt < 400; _attempt++)); do
      if ! _autolint_job_is_running "$_anchor" "$_anchor_dir/jobs"; then
        wait "$_anchor"
        _anchor_rc=0
        break
      fi
      sleep 0.01
    done
    [ "$_anchor_rc" -eq 0 ] || kill -KILL "$_anchor" 2>/dev/null
    rm -rf "$_anchor_dir"
    exit "$_anchor_rc"
  )
}

set +e
_run_dead_parent_anchor no-leader
_dead_parent_rc=$?
_run_dead_parent_anchor no-ppid
_dead_parent_ppid_rc=$?
set -e
_assert_exit "anchor without a leader marker releases after parent death" 0 \
  "$_dead_parent_rc"
_assert_exit "anchor without a PPID probe releases after parent death" 0 \
  "$_dead_parent_ppid_rc"

# A holding anchor whose parent is stopped (Ctrl-Z) polls until it resumes,
# possibly for hours. Record the pause schedule instead of sleeping through
# it: the first polls must stay fine-grained so the normal release handshake
# is cheap, and the pause must reach, but never exceed, a 1 s cap after a few
# seconds, so a long stop costs about one poll per second and a resumed
# parent waits at most that long.
_hold_schedule=$(
  CHECKRUN_LIB_DIR="$CHECKRUN_TEST_ROOT/lib/checkrun"
  # shellcheck source=../../lib/checkrun/autolint.sh
  . "$CHECKRUN_LIB_DIR/autolint.sh"
  # shellcheck disable=SC2329 # Invoked by the sourced pause helper.
  sleep() { printf '%s\n' "$1"; }
  _autolint_hold_polls=0
  for ((_poll = 0; _poll < 400; _poll++)); do
    _autolint_hold_pause
  done
)
_assert_eq "held anchor starts with 1 ms polls" "0.001" \
  "$(printf '%s\n' "$_hold_schedule" | head -n 1)"
_assert_eq "held anchor backs off to a 1 s cap after a few seconds" \
  "cap=1 before-cap-ok=1" \
  "$(printf '%s\n' "$_hold_schedule" | awk '
    { if ($1 > max) max = $1 }
    !capped && $1 >= 1 { capped = 1 }
    !capped { before += $1 }
    END { printf "cap=%s before-cap-ok=%d", max, (before >= 3 && before <= 10) }
  ')"

# The hold runs from the supervisor's EXIT trap, which keeps errexit active
# under a `set -e` caller. A failing `sleep` at any tier of the pause must
# not abort the hold, which would release the pinned identity early.
set +e
# shellcheck disable=SC2016 # This program is evaluated by the selected Bash.
_hold_errexit=$("$BASH" -ec '
  . "$1"
  sleep() { return 1; }
  _autolint_hold_polls=0
  for ((poll = 0; poll < 200; poll++)); do
    _autolint_hold_pause
  done
  printf "survived=%s\n" "$_autolint_hold_polls"
' _ "$CHECKRUN_TEST_ROOT/lib/checkrun/autolint.sh" 2>&1)
set -e
_assert_eq "held anchor survives a failing sleep under errexit" \
  "survived=200" "$_hold_errexit"

# A supervisor whose parent is stopped during validation waits at a closed
# gate just as long. Drive the real gate wait with a recording `sleep` that
# withdraws the hold after 400 polls, which the wait treats as an abort. The
# normal gate open must keep its 200 fast polls, the wait must then back off
# rather than fork a thousand sleeps a second, and its pause must stay at
# 100 ms so a TERM still lands within the parent's 200 ms cooperative grace.
_gate_wait_dir=$(mktemp -d "${TMPDIR:-/tmp}/autolint-gate-wait.XXXXXX")
printf '1\n' >"$_gate_wait_dir/hold"
set +e
_gate_schedule=$(
  CHECKRUN_LIB_DIR="$CHECKRUN_TEST_ROOT/lib/checkrun"
  # shellcheck source=../../lib/checkrun/autolint.sh
  . "$CHECKRUN_LIB_DIR/autolint.sh"
  _gate_polls=0
  # shellcheck disable=SC2329 # Invoked by the sourced gate wait.
  sleep() {
    printf '%s\n' "$1"
    _gate_polls=$((_gate_polls + 1))
    [ "$_gate_polls" -lt 400 ] || : >|"$_gate_wait_dir/hold"
  }
  _autolint_parallel_supervisor "$_gate_wait_dir/gate" \
    "$_gate_wait_dir/armed" "$_gate_wait_dir/hold" "$$" 2 "$_gate_wait_dir"
  printf 'status=%s\n' "$?"
)
set -e
rm -rf "$_gate_wait_dir"
_assert_eq "closed gate keeps 1 ms polls, then backs off in steps" \
  "polls=400 fast=200 medium=100 status=125" \
  "$(printf '%s\n' "$_gate_schedule" | awk '
    /^status=/ { status = $0; next }
    { polls++ }
    NR <= 200 && $1 == 0.001 { fast++ }
    NR > 200 && NR <= 300 && $1 == 0.01 { medium++ }
    END { printf "polls=%d fast=%d medium=%d %s", polls, fast, medium, status }
  ')"
_assert_eq "closed gate backs off to a 100 ms cap" "cap=0.1" \
  "$(printf '%s\n' "$_gate_schedule" | awk '
    /^status=/ { next }
    { if ($1 > max) max = $1 }
    END { printf "cap=%s", max }
  ')"

# Cancellation promptness, independent of host load: a supervisor that never
# quiesces must get a cooperative group TERM, at most 200 ms of 10 ms polls,
# and then KILL. Record the real escalation's signals and pauses.
_escalation_dir=$(mktemp -d "${TMPDIR:-/tmp}/autolint-escalation.XXXXXX")
printf '1\n' >"$_escalation_dir/busy"
printf '1\n' >"$_escalation_dir/hold"
: >"$_escalation_dir/exited"
_escalation_schedule=$(
  CHECKRUN_LIB_DIR="$CHECKRUN_TEST_ROOT/lib/checkrun"
  # shellcheck source=../../lib/checkrun/autolint.sh
  . "$CHECKRUN_LIB_DIR/autolint.sh"
  # shellcheck disable=SC2329 # Invoked by the sourced escalation.
  sleep() { printf 'sleep %s\n' "$1"; }
  # shellcheck disable=SC2329 # Invoked by the sourced escalation.
  kill() { printf 'kill %s\n' "$*"; }
  # shellcheck disable=SC2329 # Invoked by the sourced escalation.
  wait() { :; }
  # shellcheck disable=SC2329 # The supervisor stays in Bash's running set.
  _autolint_job_exited() { return 1; }
  _autolint_signal_status=0
  _autolint_cancel_status=143
  _autolint_cancel_private_group 424242 424242 "$_escalation_dir/busy" \
    "$_escalation_dir/exited" "$_escalation_dir/hold" "$_escalation_dir/jobs"
)
rm -rf "$_escalation_dir"
_assert_eq "escalation TERMs the group, polls at most 200 ms, then KILLs" \
  "term-first=1 longest=0.01 total-ok=1 kill-last=1" \
  "$(printf '%s\n' "$_escalation_schedule" | awk '
    NR == 1 { term_first = ($0 == "kill -TERM -424242") }
    $1 == "sleep" { total += $2; if ($2 > longest) longest = $2 }
    { last = $0 }
    END {
      printf "term-first=%d longest=%s total-ok=%d kill-last=%d", term_first,
        longest, (total > 0 && total <= 0.2001), (last == "kill -KILL -424242")
    }
  ')"

set +e
# shellcheck disable=SC2016 # This program is evaluated by the selected Bash.
"$BASH" -c '
  if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3))); then
    exit 1
  fi
  # If the child exits and Bash reaps it and drops it from the job table
  # before `wait -n` starts, as happens under CPU load, `wait -n` finds no
  # job and returns 127, and the exact wait below proves nothing about a
  # status that `wait -n` consumed. Retry with a child that lives longer
  # each time, so `wait -n` is already blocked when it exits, and fail if no
  # attempt ever reaches that state.
  for delay in 0 0.01 0.05 0.1 0.2 0.5 1; do
    (
      [ "$delay" = 0 ] || sleep "$delay"
      exit 7
    ) &
    pid=$!
    wait -n 2>/dev/null
    first_rc=$?
    wait "$pid" 2>/dev/null
    second_rc=$?
    [ "$second_rc" -eq 7 ] || exit 1
    case "$first_rc" in
      7) exit 0 ;;
      127) ;;
      *) exit 1 ;;
    esac
  done
  exit 2
' >/dev/null 2>&1
_wait_n_rc=$?
set -e
if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 3))); then
  _assert_exit "wait-n status can be retained by exact PID wait" 0 "$_wait_n_rc"
else
  _assert_exit "wait-n probe rejects unsupported Bash" 1 "$_wait_n_rc"
fi

# `$$` remains the PID of the outer Bash inside a subshell, while the current
# shell is the process that owns `$!` and `jobs`. Test PID discovery directly:
# Bash 3.2 can legitimately decline monitor-mode setup in a sourced subshell,
# which is a safe sequential fallback and must not hide whether this helper
# itself identified the correct process.
set +e
# shellcheck disable=SC2016 # This program, including its nested sh probe, is evaluated by the selected Bash.
"$BASH" -c '
  . "$1"
  (
    unset BASHPID 2>/dev/null || :
    real_sh=$(type -P sh) || exit 1
    # Bash 3.2 can retain its command-substitution shell while that shell waits
    # for an external command. Model that process tree on every Bash version by
    # putting status handling after the external sh invocation. The helper must
    # identify this sourcing subshell, not the retained intermediate process.
    sh() {
      local rc
      command "$real_sh" "$@"
      rc=$?
      return "$rc"
    }
    REPLY=""
    _autolint_current_shell_pid || exit 1
    observed=$REPLY
    # Some Bash builds tail-exec a final external command, replacing this
    # subshell with `sh` before the verifier reads PPID. That changes the very
    # parent relationship under test and produces a false failure even though
    # PID discovery was correct. A background child cannot replace its parent;
    # exact wait also preserves the verifier status as the subshell result.
    "$real_sh" -c '\''[ "$PPID" = "$1" ]'\'' _ "$observed" &
    verifier=$!
    wait "$verifier"
  )
' _ "$CHECKRUN_TEST_ROOT/lib/checkrun/autolint.sh"
_current_pid_rc=$?
set -e
_assert_exit "sourced subshell identifies its actual job-control PID" \
  0 "$_current_pid_rc"

if [[ "$(uname -s)" == Darwin ]] && ((BASH_VERSINFO[0] > 3)) &&
  /bin/bash -c '((BASH_VERSINFO[0] == 3 && BASH_VERSINFO[1] == 2))'; then
  if /bin/bash "$0"; then
    _pass "macOS system Bash 3.2 passes the lifecycle suite"
  else
    _fail "macOS system Bash 3.2 passes the lifecycle suite"
  fi
fi

_test_summary
