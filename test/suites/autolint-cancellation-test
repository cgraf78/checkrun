case "$scenario" in
  pre-gate-signal)
    # Deliver INT after validation proved the private group but before the
    # gate exists, so no planner or worker can have started.
    _autolint_validate_private_group() {
      _pgid_real_validate "$@" || return
      builtin kill -INT "$parent"
      return 0
    }
    ;;
  pre-gate-leader-lost)
    # The validated leader disappears before gate release; the parent must
    # not signal a PID that Bash has already reaped.
    _autolint_validate_private_group() {
      local attempt
      _pgid_real_validate "$@" || return
      builtin kill -KILL "$1"
      for ((attempt = 0; attempt < 300; attempt++)); do
        builtin kill -0 "$1" 2>/dev/null || break
        sleep 0.01
      done
      return 0
    }
    ;;
  unpublished-completion)
    # The supervisor completes normally but cannot publish completion: a
    # non-empty directory replacing its precreated marker rejects truncation
    # while still testing non-empty.
    _autolint_parallel_supervisor() {
      local busy="${1%/*}/busy"
      command rm -f "$busy"
      # An entry keeps the directory non-empty for `-s` on every filesystem;
      # btrfs, for one, reports an empty directory's size as zero.
      command mkdir "$busy"
      : >"$busy/entry"
      _pgid_real_supervisor "$@"
    }
    # Deliver TERM after the supervisor already left the running set.
    _autolint_job_is_running() {
      local rc=0
      _pgid_real_job_is_running "$@" || rc=$?
      if [ "$rc" -eq 1 ] && [ ! -e "$root/injected" ]; then
        : >"$root/injected"
        builtin kill -TERM "$parent"
      fi
      return "$rc"
    }
    ;;
  pre-gate-unacknowledged)
    # The supervisor cannot publish its exited marker, so the parent's grace
    # expires and it must escalate with KILL to the still-pinned exact PID.
    _autolint_validate_private_group() {
      _pgid_real_validate "$@" || return
      builtin kill -INT "$parent"
      return 0
    }
    mkdir() {
      local arg rc
      command mkdir "$@"
      rc=$?
      for arg in "$@"; do
        case "$arg" in
          */.supervisor) ln -s "$arg/missing/exited" "$arg/exited" || return $? ;;
        esac
      done
      return "$rc"
    }
    ;;
  slow-arming)
    # The supervisor installs its latches late. A TERM before then is never
    # recorded as a cancellation: it kills the supervisor or makes its EXIT
    # trap publish completion instead.
    _autolint_parallel_supervisor() {
      _pgid_arm_late
      _pgid_real_supervisor "$@"
    }
    _autolint_validate_private_group() {
      _pgid_real_validate "$@" || return
      builtin kill -TERM "$parent"
      return 0
    }
    ;;
  slow-arming-gate)
    # Without any signal, the gate must still wait for the latches: a group
    # TERM after an unarmed gate opened would kill the identity anchor.
    _autolint_parallel_supervisor() {
      _pgid_arm_late
      _pgid_real_supervisor "$@"
    }
    mkdir() {
      local arg
      for arg in "$@"; do
        case "$arg" in
          */.supervisor/gate)
            [ -e "${arg%/gate}/armed" ] || : >"$root/gate-before-armed"
            ;;
        esac
      done
      command mkdir "$@"
    }
    ;;
  external-kill-before-cancel)
    # The supervisor is killed from outside after the parent latched a
    # cancellation but before it acted on it. The supervisor's group is then
    # empty and its number free, so it must not receive the group TERM.
    _autolint_run_read_only_pipeline() {
      : >"$root/work-started"
      builtin kill -TERM "$parent"
      # Block in a builtin so the supervisor is its group's only member.
      read -r -t 10 _ <>"$root/block" || :
    }
    _autolint_cancel_private_group() {
      builtin kill -KILL "$1"
      _pgid_await_unlisted "$1" || return 1
      _pgid_real_cancel "$@"
    }
    ;;
  external-kill-during-grace)
    # The supervisor survives the cooperative group TERM and is then killed
    # from outside during the parent's grace, without publishing anything.
    # Its released group must not receive the escalating KILL.
    _autolint_run_read_only_pipeline() {
      : >"$root/work-started"
      trap '' TERM
      builtin kill -TERM "$parent"
      read -r -t 10 _ <>"$root/block" || :
    }
    _autolint_supervisor_quiesced() {
      if [ ! -e "$root/externally-killed" ]; then
        : >"$root/externally-killed"
        _pgid_leader
        builtin kill -KILL "$REPLY"
        _pgid_await_unlisted "$REPLY" || return 1
      fi
      _pgid_real_quiesced "$@"
    }
    ;;
  jobs-false-exit-cancel)
    # Once the group TERM is sent, the job table misreports the cancelled
    # supervisor as exited. The parent sends nothing more, but must still
    # release the hold, or the supervisor holds and the exact wait never ends.
    _autolint_run_read_only_pipeline() {
      local attempt
      : >"$root/work-started"
      builtin kill -TERM "$parent"
      for ((attempt = 0; attempt < 500; attempt++)); do
        [ "${_autolint_cancel_status:-0}" -eq 0 ] || break
        sleep 0.01
      done
    }
    jobs() {
      if [ "${1:-}" = -pr ] && [ -e "$root/group-term-sent" ]; then
        return 0
      fi
      builtin jobs "$@"
    }
    ;;
  jobs-false-exit-signal)
    # The job table misreports a working supervisor as exited, so the parent
    # releases it and waits for it, and a TERM then interrupts that wait. The
    # parent must wait again rather than return with the supervisor running.
    _autolint_run_read_only_pipeline() {
      local attempt
      : >"$root/work-started"
      for ((attempt = 0; attempt < 500; attempt++)); do
        [ -e "$root/parent-waiting" ] && break
        sleep 0.01
      done
      sleep 0.1
      builtin kill -TERM "$parent"
      # Outlive a parent that returns from the interrupted wait at once.
      sleep 0.5
    }
    jobs() {
      if [ "${1:-}" = -pr ] && [ -d "$plan_dir/.supervisor/gate" ]; then
        return 0
      fi
      builtin jobs "$@"
    }
    # Mark the parent's first exact wait so the TERM lands inside it.
    wait() {
      if [ "$#" -eq 1 ] && [ -d "$plan_dir/.supervisor/gate" ]; then
        : >"$root/parent-waiting"
      fi
      builtin wait "$@"
    }
    ;;
  unarmed-death)
    # The supervisor dies before arming while the parent waits to stop it.
    # Its reaped PID must not receive the TERM meant for an armed supervisor.
    _autolint_parallel_supervisor() {
      sleep 0.5
      sh -c 'kill -KILL "$PPID"'
    }
    _autolint_validate_private_group() {
      _pgid_real_validate "$@" || return
      builtin kill -INT "$parent"
      return 0
    }
    ;;
  jobs-false-exit)
    # The job table reports a live supervisor as exited, so no signal is
    # sent. The exact wait must still end: emptying hold aborts its gate wait.
    jobs() {
      [ "${1:-}" = -pr ] && return 0
      builtin jobs "$@"
    }
    ;;
  jobs-false-exit-after-gate)
    # The same misreport, but only once the supervisor is working. Its exact
    # wait must still end when it completes instead of holding forever.
    jobs() {
      if [ "${1:-}" = -pr ] && [ -d "$plan_dir/.supervisor/gate" ]; then
        return 0
      fi
      builtin jobs "$@"
    }
    ;;
  jobs-unlisted)
    # Model a full TMPDIR: `jobs` reports no write error, so its running-job
    # listing and the completeness sentinel after it are both silently lost.
    jobs() {
      [ "${1:-}" = -pr ] && return 0
      builtin jobs "$@"
    }
    printf() {
      [ "$#" -eq 2 ] && [ "$1" = '%s\n' ] && [ "$2" = end ] && return 0
      builtin printf "$@"
    }
    ;;
  release-failure)
    # The parent cannot empty the hold marker, so a released supervisor
    # would keep holding forever. The only bounded exit is KILL while still
    # pinned.
    # shellcheck disable=SC2329 # Invoked by the sourced release path.
    _autolint_unhold() { :; }
    ;;
  completion-race)
    # Deliver TERM at the parent's first poll while the supervisor is about
    # to finish on its own: any done-then-signal check is a TOCTOU window.
    eval "_pgid_real_read_status_file() $(declare -f _autolint_read_status_file | tail -n +2)"
    _autolint_read_status_file() {
      if [ ! -e "$root/injected" ] && [[ "$1" == */.supervisor/exited ]]; then
        : >"$root/injected"
        builtin kill -TERM "$parent"
      fi
      _pgid_real_read_status_file "$@"
    }
    ;;
esac

mkfifo "$root/block"
plan_dir=$(mktemp -d "$TMPDIR/pgid-plans.XXXXXX")
_autolint_run_parallel_supervised 2 "$plan_dir" first.sh second.sh
status=$?
[ "$_autolint_signal_status" -eq 0 ] || status=$_autolint_signal_status
builtin printf '%s\n' "$status" >"$root/status"
cat "$plan_dir/.supervisor/exited" >"$root/exited" 2>/dev/null || :
builtin jobs -pr >"$root/jobs-after"
command rm -rf "$plan_dir"
SH
chmod +x "$_pgid_fixture"

_run_pgid_case() {
  local description="$1" scenario="$2" expected="$3" root rc=0 pid attempt
  root="$_fixture_root/pgid-$scenario-$RANDOM"
  # Follow-up assertions on this case's artifacts read it from here.
  _pgid_case_root=$root
  mkdir -p "$root"
  # Without monitor mode, an asynchronous command starts with INT ignored,
  # which no trap can override. Give the fixture its own job like a
  # foreground command so the INT scenarios reach its managed handler.
  set -m
  "$BASH" "$_pgid_fixture" "$CHECKRUN_TEST_ROOT/lib/checkrun/autolint.sh" \
    "$root" "$scenario" >"$root/stdout" 2>"$root/stderr" &
  # shellcheck disable=SC2031 # This reads the launch above, not a subshell's $!.
  pid=$!
  set +m
  # A lost release deadlocks the fixture in an exact wait that shields TERM.
  # Bound it so that regression fails here instead of hanging the suite; a
  # holding supervisor releases itself once its parent is gone.
  for ((attempt = 0; attempt < 1000; attempt++)); do
    case " $(jobs -pr | tr '\n' ' ') " in
      *" $pid "*) sleep 0.01 ;;
      *) break ;;
    esac
  done
  if [ "$attempt" -ge 1000 ]; then
    kill -KILL "$pid" 2>/dev/null || :
    rc=124
  fi
  if [ "$rc" -eq 0 ]; then
    wait "$pid" || rc=$?
  else
    wait "$pid" 2>/dev/null || :
  fi
  _assert_exit "$description: fixture exits cleanly" 0 "$rc"
  _assert_eq "$description: status" "$expected" \
    "$(cat "$root/status" 2>/dev/null)"
  _assert_eq "$description: no stale PID/PGID signal" "" \
    "$(grep stale "$root/signals" 2>/dev/null || :)"
  _assert_eq "$description: no running job remains" "" \
    "$(cat "$root/jobs-after" 2>/dev/null)"
  case "$scenario" in
    pre-gate-* | noclobber-pre-gate-* | slow-arming | unarmed-death | \
      jobs-false-exit)
      _assert_file_missing "$description: gate never opened" \
        "$root/work-started"
      ;;
    *)
      # A run that quietly declined parallelism also reports status 0, so
      # only the supervisor's own work proves that the parallel path ran.
      _assert_file_exists "$description: gate opened" "$root/work-started"
      ;;
  esac
}

_run_pgid_case "pre-gate INT stops the supervisor without a stale group signal" \
  pre-gate-signal 130
_run_pgid_case "pre-gate leader loss sends no signal to the reaped PID" \
  pre-gate-leader-lost 0
_run_pgid_case "unpublished completion is never followed by a group signal" \
  unpublished-completion 143
_run_pgid_case "TERM racing normal completion only signals a pinned group" \
  completion-race 143
_run_pgid_case "unremovable hold marker escalates only while pinned" \
  release-failure 125
_run_pgid_case "unacknowledged pre-gate TERM escalates to the exact pinned PID" \
  pre-gate-unacknowledged 130
_assert_contains "unacknowledged pre-gate TERM: KILL reached the live PID" \
  "live" "$(grep -- '^-KILL [1-9]' "$_pgid_case_root/signals")"
_run_pgid_case "pre-gate TERM waits until the supervisor is armed" \
