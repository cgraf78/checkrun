#!/usr/bin/env bash
# autolint-cancellation-test - process and scratch lifecycle invariants.

set -o pipefail
export NO_COLOR=1

CHECKRUN_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
CHECKRUN_TEST_ROOT="$(cd -- "$CHECKRUN_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$CHECKRUN_TEST_DIR/helpers.sh"

_require_compatible_libc "autolint-cancellation-test"

# This suite wraps the host tools so it can inject failures while preserving
# their real process semantics. Minimal containers may omit procps entirely;
# skip there instead of passing Python a non-string environment value and
# misreporting every scenario as a product failure.
for _required_tool in ps mktemp mkdir rm; do
  if ! command -v "$_required_tool" >/dev/null 2>&1; then
    echo "SKIP: autolint-cancellation-test (requires $_required_tool)"
    exit 0
  fi
done
unset _required_tool

echo "=== Parallel autolint lifecycle ==="

_fixture_root=$(_tmpdir)
_tool_bin="$_fixture_root/bin"
mkdir -p "$_tool_bin"

cat >"$_tool_bin/yq" <<'SH'
#!/usr/bin/env bash
exit 0
SH
cat >"$_tool_bin/typos" <<'SH'
#!/usr/bin/env bash
exit 0
SH
cat >"$_tool_bin/ps" <<'SH'
#!/usr/bin/env bash
pgid_list=""
if [ "$#" -eq 4 ] && [ "$1" = -o ] && [ "$2" = pid=,pgid= ] && [ "$3" = -p ]; then
  printf 'called\n' >>"$AUTOLINT_CANCEL_ROOT/combined-pgid-format-calls"
  pgid_list=$4
elif [ "$#" -eq 6 ] && [ "$1" = -o ] && [ "$2" = pid= ] &&
  [ "$3" = -o ] && [ "$4" = pgid= ] && [ "$5" = -p ]; then
  printf 'called\n' >>"$AUTOLINT_CANCEL_ROOT/pgid-snapshot-calls"
  pgid_list=$6
fi
if [ -n "$pgid_list" ]; then
  leader=${pgid_list#*,}
  case "${AUTOLINT_CANCEL_PGID_SNAPSHOT:-normal}" in
    shared)
      printf '%s %s\n' "$AUTOLINT_CANCEL_PARENT_PID" "$AUTOLINT_CANCEL_PARENT_PID"
      printf '%s %s\n' "$leader" "$AUTOLINT_CANCEL_PARENT_PID"
      exit 0
      ;;
    malformed)
      printf '%s %s\n' "$AUTOLINT_CANCEL_PARENT_PID" "$AUTOLINT_CANCEL_PARENT_PID"
      printf '%s invalid\n' "$leader"
      exit 0
      ;;
  esac
  exec "$AUTOLINT_CANCEL_REAL_PS" "$@"
fi
if [ "$#" -eq 4 ] && [ "$1" = -o ] && [ "$2" = pgid= ] && [ "$3" = -p ]; then
  printf 'called\n' >>"$AUTOLINT_CANCEL_ROOT/legacy-pgid-calls"
  exec "$AUTOLINT_CANCEL_REAL_PS" "$@"
fi
if [ "$#" -eq 4 ] && [ "$1" = -o ] && [ "$2" = ppid= ] && [ "$3" = -p ]; then
  # The cancellation anchor verifies its exact parent-child relationship on
  # ps-only hosts. This targeted identity read is not a liveness-table scan.
  exec "$AUTOLINT_CANCEL_REAL_PS" "$@"
fi
printf 'called\n' >>"$AUTOLINT_CANCEL_ROOT/ps-calls"
exec "$AUTOLINT_CANCEL_REAL_PS" "$@"
SH
cat >"$_tool_bin/slow-planner" <<'PY'
#!/usr/bin/env python3
import os
from pathlib import Path
import signal
import time


root = Path(os.environ["AUTOLINT_CANCEL_ROOT"])
(root / "planner.pid").write_text(str(os.getpid()), encoding="ascii")
group = os.getpgrp()
if group != int(os.environ["AUTOLINT_CANCEL_PARENT_PID"]):
    (root / "supervisor.pid").write_text(str(group), encoding="ascii")


def terminate(_signum, _frame):
    (root / "planner.term").touch(exist_ok=True)
    raise SystemExit(143)


signal.signal(signal.SIGTERM, terminate)
(root / "planner.ready").touch(exist_ok=False)
time.sleep(1.5)
PY
cat >"$_tool_bin/shellcheck" <<'PY'
#!/usr/bin/env python3
import os
from pathlib import Path
import signal
import sys
import time


root = Path(os.environ["AUTOLINT_CANCEL_ROOT"])
source = Path(sys.argv[-1])
index = source.stem.rsplit("-", 1)[-1]
(root / f"backend-{index}.pid").write_text(str(os.getpid()), encoding="ascii")
(root / f"worker-{index}.pid").write_text(str(os.getppid()), encoding="ascii")
group = os.getpgrp()
if group != int(os.environ["AUTOLINT_CANCEL_PARENT_PID"]):
    try:
        with (root / "supervisor.pid").open("x", encoding="ascii") as stream:
            stream.write(str(group))
    except FileExistsError:
        pass


def terminate(_signum, _frame):
    (root / f"backend-{index}.term").touch(exist_ok=True)
    if os.environ.get("AUTOLINT_CANCEL_IGNORE_TERM") != "1":
        raise SystemExit(143)


signal.signal(signal.SIGTERM, terminate)
gate_fd = os.open(root / f"gate-{index}", os.O_RDONLY | os.O_NONBLOCK)
try:
    # Readiness means the TERM handler is installed and a FIFO reader exists;
    # the harness can now signal or release without racing backend startup.
    (root / f"backend-{index}.ready").touch(exist_ok=False)
    while True:
        try:
            released = os.read(gate_fd, 1)
        except BlockingIOError:
            released = b""
        if released:
            break
        time.sleep(0.005)
finally:
    os.close(gate_fd)

print(f"backend:{index}", flush=True)
with (root / "backend-completion-order").open("a", encoding="ascii") as stream:
    stream.write(f"{index}\n")
(root / f"backend-{index}.done").touch(exist_ok=False)
raise SystemExit(int(os.environ.get(f"AUTOLINT_CANCEL_EXIT_{index}", "0")))
PY
chmod +x "$_tool_bin/yq" "$_tool_bin/typos" "$_tool_bin/ps" \
  "$_tool_bin/slow-planner" "$_tool_bin/shellcheck"

_driver="$_fixture_root/driver"
cat >"$_driver" <<'SH'
#!/usr/bin/env bash
set -u

impl=$1
root=$2
mode=$3
count=$4
jobs=$5

mkdir -p "$root/tmp"
export TMPDIR="$root/tmp"
export CHECKRUN_CONFIG_DIR=/nonexistent
export CHECKRUN_AUTOLINT_JOBS="$jobs"
export AUTOLINT_CANCEL_ROOT="$root"
export AUTOLINT_CANCEL_PARENT_PID=${BASHPID:-$$}

# shellcheck source=/dev/null
. "$impl"

case "$mode" in
  capability-fallback)
    command() {
      if [ "${1:-}" = -v ] && [ "${2:-}" = ps ]; then
        return 1
      fi
      builtin command "$@"
    }
    _autolint_read_proc_group() { return 1; }
    ps() { return 127; }
    ;;
  allocation-fallback)
    mktemp() {
      if [ "${1:-}" = -d ]; then
        return 1
      fi
      "$AUTOLINT_CANCEL_REAL_MKTEMP" "$@"
    }
    ;;
  allocation-fallback-signal)
    mktemp() {
      if [ "${1:-}" = -d ]; then
        return 1
      fi
      "$AUTOLINT_CANCEL_REAL_MKTEMP" "$@"
    }
    ;;
  capability-fallback-signal)
    command() {
      if [ "${1:-}" = -v ] && [ "${2:-}" = ps ]; then
        return 1
      fi
      builtin command "$@"
    }
    _autolint_read_proc_group() { return 1; }
    ps() { return 127; }
    ;;
  allocation-signal)
    mktemp() {
      local rc
      "$AUTOLINT_CANCEL_REAL_MKTEMP" "$@"
      rc=$?
      kill -TERM "$AUTOLINT_CANCEL_PARENT_PID"
      return "$rc"
    }
    ;;
  cleanup-signal)
    rm() {
      local rc
      "$AUTOLINT_CANCEL_REAL_RM" "$@"
      rc=$?
      if [ "${1:-}" = -rf ] && [ ! -e "$root/cleanup-signalled" ]; then
        : >"$root/cleanup-signalled"
        kill -TERM "$AUTOLINT_CANCEL_PARENT_PID"
      fi
      return "$rc"
    }
    ;;
  cleanup-group-signal)
    _autolint_cleanup_attempt=0
    rm() {
      local rc cleanup_child
      if [ "${1:-}" = -rf ]; then
        _autolint_cleanup_attempt=$((_autolint_cleanup_attempt + 1))
        printf '%s\n' "$_autolint_cleanup_attempt" >>"$root/cleanup-attempts"
        if [ "$_autolint_cleanup_attempt" -eq 1 ]; then
          # Give the harness a live child wait to interrupt with a terminal-group
          # signal. A fast real rm would not prove that active cleanup returns
          # the signal status which drives the managed retry.
          sleep 30 &
          cleanup_child=$!
          printf '%s\n' "$cleanup_child" >"$root/cleanup-child.pid"
          : >"$root/cleanup-ready"
          if wait "$cleanup_child"; then
            rc=0
          else
            rc=$?
          fi
          printf '%s\n' "$rc" >"$root/cleanup-first-status"
          return "$rc"
        fi
      fi
      "$AUTOLINT_CANCEL_REAL_RM" "$@"
    }
    ;;
  cleanup-retry-signal)
    _autolint_cleanup_attempt=0
    rm() {
      if [ "${1:-}" = -rf ]; then
        _autolint_cleanup_attempt=$((_autolint_cleanup_attempt + 1))
        printf '%s\n' "$_autolint_cleanup_attempt" >>"$root/cleanup-attempts"
        if [ "$_autolint_cleanup_attempt" -eq 1 ]; then
          return 73
        fi
        if [ "$_autolint_cleanup_attempt" -eq 2 ]; then
          # Publish readiness only from inside the retry, then hold until the
          # managed handler records TERM. This pins the signal to the retry
          # window instead of merely observing it before or after cleanup.
          : >"$root/cleanup-retry-ready"
          while [ "${_autolint_signal_status:-0}" -eq 0 ]; do
            sleep 0.01
          done
          return "$_autolint_signal_status"
        fi
      fi
      "$AUTOLINT_CANCEL_REAL_RM" "$@"
    }
    ;;
  cleanup-failure | cleanup-failure-errexit)
    _autolint_cleanup_attempt=0
    rm() {
      if [ "${1:-}" = -rf ]; then
        _autolint_cleanup_attempt=$((_autolint_cleanup_attempt + 1))
        printf '%s\n' "$_autolint_cleanup_attempt" >>"$root/cleanup-attempts"
        return 73
      fi
      "$AUTOLINT_CANCEL_REAL_RM" "$@"
    }
    ;;
  validation-cleanup-failure)
    _autolint_failed_cleanup_dir=""
    _autolint_cleanup_attempt=0
    _autolint_validate_private_group() { return 1; }
    rm() {
      if [ "${1:-}" = -rf ]; then
        if [ -z "$_autolint_failed_cleanup_dir" ]; then
          _autolint_failed_cleanup_dir=${2:-}
        fi
        if [ "${2:-}" = "$_autolint_failed_cleanup_dir" ]; then
          _autolint_cleanup_attempt=$((_autolint_cleanup_attempt + 1))
          printf '%s\n' "$_autolint_cleanup_attempt" >>"$root/cleanup-attempts"
          return 73
        fi
      fi
      "$AUTOLINT_CANCEL_REAL_RM" "$@"
    }
    ;;
  gate-failure)
    # Exercise the same targeted-ps validation path used on hosts without
    # procfs; the injected gate failure occurs only after that validation.
    _autolint_read_proc_group() { return 1; }
    mkdir() {
      local arg
      for arg in "$@"; do
        case "$arg" in
          */.supervisor/gate)
            : >"$root/gate-release-attempted"
            return 73
            ;;
        esac
      done
      "$AUTOLINT_CANCEL_REAL_MKDIR" "$@"
    }
    kill() {
      case "${1:-}:${2:-}" in
        -TERM:-* | -KILL:-*)
          : >"$root/gate-group-signal"
          ;;
        -TERM:[1-9]*)
          : >"$root/gate-direct-stop"
          ;;
      esac
      builtin kill "$@"
    }
    ;;
  gate-visible-failure | gate-visible-failure-signal)
    _autolint_read_proc_group() { return 1; }
    _autolint_pre_plan() {
      printf 'x\n' >"$1/0.plan"
      printf 'x\n' >"$1/1.plan"
    }
    _autolint_try_clean_batch() { return 1; }
    _lint_one_with_plan() {
      printf '%s\n' "${BASHPID:-$$}" >"$root/gate-visible-worker.pid"
      : >"$root/gate-visible-worker.ready"
      if [ "$mode" = gate-visible-failure-signal ]; then
        trap '' TERM
      fi
      sleep 30
    }
    mkdir() {
      local arg rc worker group
      "$AUTOLINT_CANCEL_REAL_MKDIR" "$@"
      rc=$?
      for arg in "$@"; do
        case "$arg" in
          */.supervisor/gate)
            # The real mkdir above creates the gate; wait until authorized work
            # is visible before returning failure. This models mkdir succeeding at the
            # filesystem boundary but reporting interruption, where exact-PID
            # cleanup would miss descendants and the validated group must win.
            while [ ! -e "$root/gate-visible-worker.ready" ]; do
              sleep 0.01
            done
            IFS= read -r worker <"$root/gate-visible-worker.pid"
            group=$(LC_ALL=C "$AUTOLINT_CANCEL_REAL_PS" -o pgid= -p "$worker")
            group=${group//[[:space:]]/}
            printf '%s\n' "$group" >"$root/supervisor.pid"
            : >"$root/gate-visible-release-attempted"
            return 73
            ;;
        esac
      done
      return "$rc"
    }
    kill() {
      case "${1:-}:${2:-}" in
        -TERM:-*)
          : >"$root/gate-visible-group-signal"
          [ "$mode" != gate-visible-failure-signal ] || \
            : >"$root/gate-visible-cancel-started"
          ;;
        -KILL:-*) : >"$root/gate-visible-group-signal" ;;
      esac
      builtin kill "$@"
    }
    ;;
  leader-marker-failure)
    mkdir() {
      local arg rc
      "$AUTOLINT_CANCEL_REAL_MKDIR" "$@"
      rc=$?
      for arg in "$@"; do
        case "$arg" in
          */.supervisor)
            # Permission bits are not a deterministic write-failure injection:
            # root inside a container can bypass a mode-500 directory. A
            # directory at the marker pathname rejects redirection on every
            # supported host while leaving the control root removable.
            "$AUTOLINT_CANCEL_REAL_MKDIR" "$arg/leader" || return $?
            ;;
        esac
      done
      return "$rc"
    }
    ;;
  anchor-mismatch)
    ;;
  monitor)
    set -m
    _autolint_pre_plan() {
      printf 'x\n' >"$1/0.plan"
      printf 'x\n' >"$1/1.plan"
    }
    _autolint_try_clean_batch() { return 1; }
    _lint_one_with_plan() { :; }
    mkdir() {
      local arg rc
      "$AUTOLINT_CANCEL_REAL_MKDIR" "$@"
      rc=$?
      for arg in "$@"; do
        case "$arg" in
          # The real mkdir already released the child. Hold the parent here so
          # a fast supervisor can finish while notifications are disabled;
          # restoring monitor mode later must not emit a stale job message.
          */.supervisor/gate) sleep 0.1 ;;
        esac
      done
      return "$rc"
    }
    ;;
  pre-wait-signal)
    _autolint_poll_signal_sent=0
    _autolint_read_status_file() {
      if [ "${BASH_SUBSHELL:-0}" -eq 0 ] &&
        [ "$_autolint_poll_signal_sent" -eq 0 ] &&
        [[ "$1" == */.supervisor/exited ]]; then
        # Inject immediately after the parent's latch check, at its first owned
        # event probe. This retains the former pre-wait race coverage now that
        # the implementation deliberately avoids a blocking wait on a live
        # cancellation anchor.
        _autolint_poll_signal_sent=1
        : >"$root/pre-wait-signal"
        kill -TERM "$AUTOLINT_CANCEL_PARENT_PID"
      fi
      return 1
    }
    ;;
  restore-signal)
    _autolint_restore_signal_traps() {
      local saved_hup="$1" saved_int="$2" saved_term="$3"
      if [ ! -e "$root/restore-signal" ]; then
        # Inject before evaluating the saved handlers. The managed TERM trap must
        # still own this boundary so the operation records cancellation instead
        # of invoking the caller trap halfway through restoration.
        : >"$root/restore-signal"
        kill -TERM "$AUTOLINT_CANCEL_PARENT_PID"
      fi
      eval "${saved_hup:-trap - HUP}"
      eval "${saved_int:-trap - INT}"
      eval "${saved_term:-trap - TERM}"
    }
    ;;
  planner-signal)
    _autolint_pre_plan() { slow-planner; }
    ;;
  direct-one-signal)
    _autolint_pre_plan() { slow-planner; }
    ;;
  validation-fallback | validation-fallback-signal)
    _autolint_validate_private_group() { return 1; }
    ;;
  shared-pgid)
    _autolint_read_proc_group() { return 1; }
    ;;
  malformed-pgid)
    _autolint_read_proc_group() { return 1; }
    ;;
  ps-pgid-success)
    _autolint_read_proc_group() { return 1; }
    ;;
  repeat)
    kill() {
      local group attempt
      if [ "${1:-}" = -KILL ] && [[ "${2:-}" == -[1-9]* ]]; then
        group=${2#-}
        if builtin kill -0 "$group" 2>/dev/null; then
          : >"$root/group-kill-anchored"
        fi
        # The repeat scenario must inject its second signal after production has
        # frozen terminal-signal traps but before exact cleanup restores the
        # caller's traps. Fast hosts can otherwise finish KILL plus wait before
        # the Python driver runs again, turning the test into a post-operation
        # signal that correctly invokes the caller's restored HUP trap. Publish
        # this exact escalation boundary and hold it until the driver sends HUP.
        # Keep the wait bounded so a broken driver cannot strand this fixture.
        : >"$root/repeat-cleanup-frozen"
        for ((attempt = 0; attempt < 500; attempt++)); do
          [ -e "$root/repeat-second-signal-sent" ] && break
          sleep 0.01
        done
      fi
      builtin kill "$@"
    }
    ;;
  wave)
    _autolint_supports_pool() { return 1; }
    ;;
esac

case "$mode" in
  capability-fallback | validation-fallback | validation-cleanup-failure | \
    shared-pgid | malformed-pgid | gate-failure)
    # Restricted-host fallback must stay foreground-only. Parent-only signals
    # cannot safely reach grandchildren without a validated private PGID, so a
    # pool or wave here would trade latency for orphaned backend processes.
    _autolint_run_files_pool() {
      : >"$root/unsafe-fallback-pool"
      return 99
    }
    _autolint_run_file_batch() {
      : >"$root/unsafe-fallback-wave"
      return 99
    }
    ;;
esac

case "$mode" in
  allocation-fallback-signal | capability-fallback-signal | validation-fallback-signal)
    _autolint_direct_fallback_probe() {
      local scratch=()
      shopt -s nullglob
      scratch=("$root/tmp"/autolint-plans.*)
      shopt -u nullglob
      # The portable fallback owns a fresh plan root so it can retain batching.
      # The managed candidate is the one that must be gone; its .supervisor
      # control directory distinguishes the two lifetimes without relying on a
      # reusable pathname or allocation order.
      if [ "${#scratch[@]}" -eq 0 ] ||
        { [ "${#scratch[@]}" -eq 1 ] && [ ! -e "${scratch[0]}/.supervisor" ]; }; then
        : >"$root/fallback-scratch-clean"
      else
        : >"$root/fallback-scratch-present"
      fi
      : >"$root/direct-fallback.ready"
      sleep 30
    }
    _autolint_pre_plan() { _autolint_direct_fallback_probe; }
    _lint_one() { _autolint_direct_fallback_probe; }
    ;;
esac

if { [[ "$count" -lt 2 || "$jobs" -lt 2 ]]; } &&
  [ "$mode" != gate-visible-failure ] &&
  [ "$mode" != gate-visible-failure-signal ]; then
  _autolint_run_parallel_supervised() {
    : >"$root/unexpected-supervisor"
    return 99
  }
fi

if [ "$mode" = cleanup-failure-errexit ]; then
  set -e
fi

case "$mode" in
  allocation-fallback-signal | capability-fallback-signal | \
    validation-fallback-signal | direct-one-signal | direct-jobs-one-signal)
    trap - HUP INT TERM
    ;;
  *)
    trap 'printf "HUP\n" >>"$root/prior-trap-ran"' HUP
    trap 'printf "INT\n" >>"$root/prior-trap-ran"' INT
    trap 'printf "TERM\n" >>"$root/prior-trap-ran"' TERM
    ;;
esac
trap -p HUP >"$root/trap-hup.before"
trap -p INT >"$root/trap-int.before"
trap -p TERM >"$root/trap-term.before"
printf '%s\n' "$-" >"$root/options.before"
set +o >"$root/set-o.before"
REPLY=caller-value

_record_driver_state() {
  local status="$1" pid_file pid state
  printf '%s\n' "$status" >"$root/operation-status"
  : >"$root/processes.before-exit"
  for pid_file in "$root"/anchor.pid "$root"/supervisor.pid \
    "$root"/gate-visible-worker.pid "$root"/worker-*.pid \
    "$root"/backend-*.pid "$root"/planner.pid; do
    [ -f "$pid_file" ] || continue
    IFS= read -r pid <"$pid_file" || continue
    [ "$pid" != "$AUTOLINT_CANCEL_PARENT_PID" ] || continue
    if state=$(LC_ALL=C "$AUTOLINT_CANCEL_REAL_PS" -o stat= -p "$pid" 2>/dev/null); then
      [ -z "$state" ] || printf '%s\t%s\n' "$pid" "$state" >>"$root/processes.before-exit"
    fi
  done
  trap -p HUP >"$root/trap-hup.after"
  trap -p INT >"$root/trap-int.after"
  trap -p TERM >"$root/trap-term.after"
  printf '%s\n' "$-" >"$root/options.after"
  set +o >"$root/set-o.after"
  printf '%s\n' "$REPLY" >"$root/reply.after"
}

if [ "$mode" = cleanup-failure-errexit ]; then
  trap '_driver_status=$?; _record_driver_state "$_driver_status"' EXIT
fi

files=()
for ((index = 0; index < count; index++)); do
  file="$root/case-$index.sh"
  printf '#!/usr/bin/env bash\nprintf "%%s\\n" ok\n' >"$file"
  mkfifo "$root/gate-$index"
  files+=("$file")
done

if [ "$mode" = monitor ]; then
  monitor_plan_dir=$(mktemp -d "$TMPDIR/monitor-plans.XXXXXX")
  json=0
  _autolint_signal_status=0
  _autolint_cancel_status=0
  _autolint_parallel_validated=0
  _autolint_run_parallel_supervised 2 "$monitor_plan_dir" first.sh second.sh
  operation_status=$?
  rm -rf "$monitor_plan_dir"
elif [ "$mode" = gate-visible-failure ] ||
  [ "$mode" = gate-visible-failure-signal ]; then
  visible_plan_dir=$(mktemp -d "$TMPDIR/gate-visible-plans.XXXXXX")
  visible_saved_hup=$(trap -p HUP)
  visible_saved_int=$(trap -p INT)
  visible_saved_term=$(trap -p TERM)
  json=0
  _autolint_signal_status=0
  _autolint_cancel_status=0
  _autolint_parallel_validated=0
  trap '_autolint_record_signal 129' HUP
  trap '_autolint_record_signal 130' INT
  trap '_autolint_record_signal 143' TERM
  _autolint_run_parallel_supervised \
    2 "$visible_plan_dir" first.sh second.sh
  operation_status=$?
  [ "$_autolint_signal_status" -eq 0 ] || operation_status=$_autolint_signal_status
  _autolint_restore_signal_traps \
    "$visible_saved_hup" "$visible_saved_int" "$visible_saved_term"
  rm -rf "$visible_plan_dir"
elif [ "$mode" = anchor-hold ]; then
  anchor_dir=$(mktemp -d "$TMPDIR/anchor-plans.XXXXXX")
  anchor_gate="$anchor_dir/gate"
  anchor_done="$anchor_dir/done"
  anchor_exited="$anchor_dir/exited"
  anchor_leader="$anchor_dir/leader"
  mkdir "$anchor_gate"
  anchor_saved_hup=$(trap -p HUP)
  anchor_saved_int=$(trap -p INT)
  anchor_saved_term=$(trap -p TERM)
  trap ':' HUP INT TERM
  (
    while [ ! -e "$root/anchor-launch" ]; do
      sleep 0.01
    done
    _autolint_cancel_status=143
    _autolint_finish_parallel_supervisor \
      "$AUTOLINT_CANCEL_PARENT_PID" "$anchor_gate" "$anchor_done" \
      "$anchor_exited" "$anchor_leader"
  ) &
  anchor_pid=$!
