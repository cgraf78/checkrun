    "validation-fallback-signal": ("validation-fallback-signal", 2, 2, 143),
    "shared-pgid": ("shared-pgid", 2, 2, 0),
    "malformed-pgid": ("malformed-pgid", 2, 2, 0),
    "ps-pgid-success": ("ps-pgid-success", 2, 2, 0),
    "one": ("normal", 1, 2, 0),
