# Every parent-side kill below goes through a wrapper that first gives an
# exiting target up to 300 ms to disappear and then records whether the target
# still had a live (or zombie) member. A signal to an empty PGID or a reaped
# PID is exactly the window in which an unrelated process can reuse the
# number, so any `stale` record is a failure even though no reuse is forced.
_pgid_fixture="$_fixture_root/pgid-identity"
cat >"$_pgid_fixture" <<'SH'
#!/usr/bin/env bash
set -u

impl=$1
root=$2
scenario=$3

mkdir -p "$root/tmp"
export TMPDIR="$root/tmp"
export CHECKRUN_CONFIG_DIR=/nonexistent

# shellcheck source=/dev/null
. "$impl"

