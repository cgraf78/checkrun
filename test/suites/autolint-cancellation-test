  _autolint_restore_signal_traps \
    "$anchor_saved_hup" "$anchor_saved_int" "$anchor_saved_term"
  operation_status=0
  rm -rf "$anchor_dir"
elif [ "$mode" = anchor-mismatch ]; then
  mismatch_dir=$(mktemp -d "$TMPDIR/anchor-mismatch.XXXXXX")
  mismatch_busy="$mismatch_dir/busy"
  mismatch_hold="$mismatch_dir/hold"
  mismatch_exited="$mismatch_dir/exited"
  mismatch_leader="$mismatch_dir/leader"
  printf '1\n' >"$mismatch_busy"
  printf '1\n' >"$mismatch_hold"
  (
    _autolint_read_process_parent() {
      REPLY=1
      return 0
    }
    kill() {
      case "${1:-}:${2:-}" in
        -HUP:"$AUTOLINT_CANCEL_PARENT_PID" | \
          -INT:"$AUTOLINT_CANCEL_PARENT_PID" | \
          -TERM:"$AUTOLINT_CANCEL_PARENT_PID")
          : >"$root/anchor-signalled-mismatched-parent"
          return 0
          ;;
      esac
      builtin kill "$@"
    }
    _autolint_cancel_status=143
    _autolint_finish_parallel_supervisor \
      "$AUTOLINT_CANCEL_PARENT_PID" "$mismatch_busy" "$mismatch_hold" \
      "$mismatch_exited" "$mismatch_leader"
  ) &
  mismatch_pid=$!
  printf '%s\n' "$mismatch_pid" >"$mismatch_leader"
  wait "$mismatch_pid"
  operation_status=$?
  rm -rf "$mismatch_dir"
else
  _autolint_main "${files[@]+"${files[@]}"}"
  operation_status=$?
fi

_record_driver_state "$operation_status"
exit 0
