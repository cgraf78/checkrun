#!/usr/bin/env bash
# Guard the startup shape and latency of Checkrun's edit-hook no-op path.

set -o pipefail
export NO_COLOR=1

CHECKRUN_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
CHECKRUN_REPO_ROOT="$(cd -- "$CHECKRUN_TEST_DIR/.." && pwd -P)"
AUTOFORMAT="$CHECKRUN_REPO_ROOT/bin/autoformat"
AUTOLINT="$CHECKRUN_REPO_ROOT/bin/autolint"

# shellcheck source=../helpers.sh
. "$CHECKRUN_TEST_DIR/helpers.sh"

if [[ "${CHECKRUN_HOOK_PERF_STRUCTURAL_ONLY:-0}" != 1 ]]; then
  _require_compatible_libc "hook-performance-test"
fi
_mock_home

CHECKRUN_HOOK_PERF_RUNS=${CHECKRUN_HOOK_PERF_RUNS:-20}
CHECKRUN_SUPPORTED_BATCH_RUNS=${CHECKRUN_SUPPORTED_BATCH_RUNS:-20}
# Process-count assertions below diagnose the specific startup regression.
# Keep wall-clock limits coarse enough to tolerate scheduler and filesystem
# contention on shared runners while still rejecting multi-second steady-state
# hook latency.
CHECKRUN_FORMAT_HOOK_MEDIAN_BUDGET_MS=1000
CHECKRUN_FORMAT_HOOK_DARWIN_MEDIAN_BUDGET_MS=1500
CHECKRUN_FORMAT_HOOK_P95_BUDGET_MS=3000
CHECKRUN_FORMAT_HOOK_DARWIN_P95_BUDGET_MS=4500
CHECKRUN_LINT_HOOK_MEDIAN_BUDGET_MS=1200
CHECKRUN_LINT_HOOK_DARWIN_MEDIAN_BUDGET_MS=1800
CHECKRUN_LINT_HOOK_P95_BUDGET_MS=3500
CHECKRUN_LINT_HOOK_DARWIN_P95_BUDGET_MS=5000
CHECKRUN_EMPTY_BATCH_MEDIAN_BUDGET_MS=1000
CHECKRUN_EMPTY_BATCH_DARWIN_MEDIAN_BUDGET_MS=1500
CHECKRUN_EMPTY_BATCH_P95_BUDGET_MS=3000
CHECKRUN_EMPTY_BATCH_DARWIN_P95_BUDGET_MS=4500
CHECKRUN_SUPPORTED_BATCH_MEDIAN_BUDGET_MS=1600
CHECKRUN_SUPPORTED_BATCH_DARWIN_MEDIAN_BUDGET_MS=2400
CHECKRUN_SUPPORTED_BATCH_P95_BUDGET_MS=3500
CHECKRUN_SUPPORTED_BATCH_DARWIN_P95_BUDGET_MS=5000

_perf_budget_ms() {
  local budget_ms="$1" darwin_budget_ms="$2"
  local multiplier="${CHECKRUN_PERF_BUDGET_MULTIPLIER:-1}"

  if [[ "$(uname -s)" == Darwin ]]; then
    budget_ms="$darwin_budget_ms"
  fi
  if ! [[ "$multiplier" =~ ^[1-9][0-9]*$ ]]; then
    multiplier=1
  fi
  printf '%s\n' "$((budget_ms * multiplier))"
}

_measure_hook_perf() {
  local command="$1"
  shift

  PATH="$hook_path" TMPDIR="$td" CHECKRUN_CONFIG_DIR=/nonexistent \
    CHECKRUN_SCHEMA_LINT=/nonexistent python3 - \
    "$CHECKRUN_HOOK_PERF_RUNS" "$command" "$@" <<'PY'
import math
import os
import signal
import subprocess
import sys
import tempfile
import time

runs = int(sys.argv[1])
command = sys.argv[2:]
timeout = float(os.environ.get("CHECKRUN_HOOK_PERF_TIMEOUT_SECONDS", "10"))
timeout_ms = math.ceil(timeout * 1000)


def sample() -> int:
    started = time.perf_counter_ns()
    with tempfile.TemporaryDirectory(
        prefix="checkrun-hook-sample.", dir=os.environ["TMPDIR"]
    ) as sample_tmp:
        sample_env = os.environ.copy()
        sample_env["TMPDIR"] = sample_tmp
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=sample_env,
            start_new_session=True,
        )
        try:
            output, _ = process.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            # Kill the whole isolated group before TemporaryDirectory removes
            # planner scratch. One timeout is excluded by a 20-sample p95;
            # two still make the coarse wall-clock gate fail.
            try:
                os.killpg(process.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                output, _ = process.communicate(timeout=0.5)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                output, _ = process.communicate()
            return timeout_ms
    elapsed_ms = max(1, (time.perf_counter_ns() - started) // 1_000_000)
    if process.returncode != 0:
        output = output.decode(errors="replace")
        raise SystemExit(
            f"{command[0]} exited {process.returncode} during performance sample: {output}"
        )
    return elapsed_ms


sample()  # Warm interpreter and filesystem caches before collecting samples.
durations = sorted(sample() for _ in range(runs))
p95_index = math.ceil(len(durations) * 0.95) - 1
timeouts = sum(duration >= timeout_ms for duration in durations)
print(f"{durations[p95_index]} {durations[len(durations) // 2]} {timeouts}")
PY
}

_assert_perf_result() {
  local name="$1" result="$2" rc="$3" median_budget_ms="$4" p95_budget_ms="$5"
  local p95_ms median_ms timeout_count

  _assert_exit "hook performance: all ${name} samples exit 0" 0 "$rc"
  read -r p95_ms median_ms timeout_count <<<"$result"
  if [[ "$p95_ms" =~ ^[0-9]+$ && "$median_ms" =~ ^[0-9]+$ && "$timeout_count" =~ ^[0-9]+$ ]]; then
    echo "  PERF: ${name} median ${median_ms}ms / ${median_budget_ms}ms, p95 ${p95_ms}ms / ${p95_budget_ms}ms (timeouts ${timeout_count}, runs ${CHECKRUN_HOOK_PERF_RUNS})"
    if [[ "$median_ms" -le "$median_budget_ms" ]]; then
      _pass "hook performance: ${name} median stays within budget"
    else
      _fail "hook performance: ${name} median ${median_ms}ms exceeds ${median_budget_ms}ms"
    fi
    if [[ "$p95_ms" -le "$p95_budget_ms" ]]; then
      _pass "hook performance: ${name} p95 stays within budget"
    else
      _fail "hook performance: ${name} p95 ${p95_ms}ms exceeds ${p95_budget_ms}ms"
    fi
  else
    _fail "hook performance: ${name} timer returned invalid result '$result'"
  fi
}

echo "=== checkrun: edit-hook performance ==="

td=$(_tmpdir)
unsupported="$td/unsupported.no-checkrun-tool"
printf 'plain text\n' >"$unsupported"
unsupported_batch=()
for index in {0..19}; do
  batch_file="$td/unsupported-$index.no-checkrun-tool"
  printf 'plain text %s\n' "$index" >"$batch_file"
  unsupported_batch+=("$batch_file")
done
supported_batch=()
for index in {0..299}; do
  batch_file="$td/supported-$index.py"
  printf 'value_%s = %s\n' "$index" "$index" >"$batch_file"
  supported_batch+=("$batch_file")
done
large_manifest="$td/large-files0"
for index in {0..999}; do
  printf '%s\0' "$td/$(printf 'long-path-%04d-%0130d.py' "$index" 0)" >>"$large_manifest"
done
small_manifest="$td/small-files0"
printf '%s\0%s\0' "$td/one.py" "$td/two.py" >"$small_manifest"
host_ps=$(command -v ps || true)

hook_path=$(_mock_bin)
hook_tools=(awk bash cat dirname getconf mkdir mktemp python3 rm sleep)
[[ -z "$host_ps" ]] || hook_tools+=(ps)
for tool in "${hook_tools[@]}"; do
  ln -s "$(command -v "$tool")" "$hook_path/$tool"
done
cat >"$hook_path/yq" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
cat >"$hook_path/typos" <<'EOF'
#!/usr/bin/env bash
[[ -n "${CHECKRUN_LINTER_LOG:-}" ]] && printf 'typos\n' >>"$CHECKRUN_LINTER_LOG"
if [[ -n "${CHECKRUN_LINTER_PATH_LOG:-}" ]]; then
  for arg in "$@"; do
    case "$arg" in
      *.py) printf 'typos\t%s\n' "$arg" >>"$CHECKRUN_LINTER_PATH_LOG" ;;
    esac
  done
fi
exit 0
EOF
cat >"$hook_path/ruff" <<'EOF'
#!/usr/bin/env bash
[[ -n "${CHECKRUN_LINTER_LOG:-}" ]] && printf 'ruff\n' >>"$CHECKRUN_LINTER_LOG"
if [[ -n "${CHECKRUN_LINTER_PATH_LOG:-}" ]]; then
  for arg in "$@"; do
    case "$arg" in
      *.py) printf 'ruff\t%s\n' "$arg" >>"$CHECKRUN_LINTER_PATH_LOG" ;;
    esac
  done
fi
exit 0
EOF
chmod +x "$hook_path/yq" "$hook_path/typos" "$hook_path/ruff"

# Force the restricted-host path even on Linux CI, where /proc would otherwise
# make the cancellation supervisor available. Keeping this as an executable
# wrapper lets the wall-clock sampler exercise the real planner and adapters
# while substituting only the two process-group inspection capabilities.
portable_autolint="$td/portable-autolint"
cat >"$portable_autolint" <<'EOF'
#!/usr/bin/env bash
set -u
. "$CHECKRUN_AUTOLINT_IMPL"
_autolint_read_proc_group() { return 1; }
ps() { return 127; }
_autolint_main "$@"
EOF
chmod +x "$portable_autolint"
export CHECKRUN_AUTOLINT_IMPL="$CHECKRUN_REPO_ROOT/lib/checkrun/autolint.sh"

if [[ "${CHECKRUN_HOOK_PERF_STRUCTURAL_ONLY:-0}" != 1 ]]; then
  timeout_count_file="$td/timeout-count"
  timeout_child_file="$td/timeout-child"
  timeout_fixture="$td/timeout-fixture"
  printf '0\n' >"$timeout_count_file"
  cat >"$timeout_fixture" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
count=$(cat "$CHECKRUN_TIMEOUT_COUNT_FILE")
count=$((count + 1))
printf '%s\n' "$count" >"$CHECKRUN_TIMEOUT_COUNT_FILE"
if [[ "$count" -eq 2 ]]; then
  mkdir -p "$TMPDIR/planner-scratch"
  sleep 30 &
  printf '%s\n' "$!" >"$CHECKRUN_TIMEOUT_CHILD_FILE"
  wait
fi
EOF
  chmod +x "$timeout_fixture"
  timeout_result=$(
    CHECKRUN_HOOK_PERF_RUNS=2 \
      CHECKRUN_HOOK_PERF_TIMEOUT_SECONDS=1 \
      CHECKRUN_TIMEOUT_COUNT_FILE="$timeout_count_file" \
      CHECKRUN_TIMEOUT_CHILD_FILE="$timeout_child_file" \
      _measure_hook_perf "$timeout_fixture" "$td/unused"
  )
  read -r _ _ timeout_count <<<"$timeout_result"
  _assert_eq "hook timeout: one stalled sample is reported" "1" "$timeout_count"
  timeout_child=""
  [[ -f "$timeout_child_file" ]] && timeout_child=$(cat "$timeout_child_file")
  if [[ "$timeout_child" =~ ^[1-9][0-9]*$ ]]; then
    _pass "hook timeout: descendant process was observed"
    timeout_child_state=""
    if [[ -n "$host_ps" ]]; then
      for _ in {1..20}; do
        timeout_child_state=$("$host_ps" -p "$timeout_child" -o stat= 2>/dev/null || true)
        [[ -z "$timeout_child_state" || "$timeout_child_state" == Z* ]] && break
        sleep 0.05
      done
    fi
    if [[ -z "$host_ps" ]]; then
      echo "  - skipping descendant process-state assertion (ps unavailable)"
    elif [[ -z "$timeout_child_state" || "$timeout_child_state" == Z* ]]; then
      _pass "hook timeout: isolated descendant process is terminated"
    else
      _fail "hook timeout: descendant remained alive (pid=$timeout_child state=$timeout_child_state)"
      kill "$timeout_child" 2>/dev/null || true
    fi
  else
    _fail "hook timeout: descendant PID was not observed"
  fi
  if compgen -G "$td/checkrun-hook-sample.*" >/dev/null; then
    _fail "hook timeout: per-sample scratch directory remains"
  else
    _pass "hook timeout: per-sample scratch directory is removed"
  fi
fi

real_python=$(command -v python3)
python_log="$td/python.log"
python_wrapper="$td/python-wrapper"
cat >"$python_wrapper" <<'EOF'
#!/usr/bin/env bash
printf '%q ' "$@" >>"$CHECKRUN_PYTHON_LOG"
printf '\n' >>"$CHECKRUN_PYTHON_LOG"
exec "$CHECKRUN_REAL_PYTHON" "$@"
EOF
chmod +x "$python_wrapper"
: >"$python_log"

CHECKRUN_REAL_PYTHON="$real_python" \
  CHECKRUN_PYTHON_LOG="$python_log" \
  CHECKRUN_PYTHON="$python_wrapper" \
  CHECKRUN_CONFIG_DIR=/nonexistent \
  PATH="$hook_path" \
  "$AUTOFORMAT" "$unsupported"
rc=$?
_assert_exit "hook startup: unsupported file exits 0" 0 "$rc"

python_processes=$(wc -l <"$python_log")
python_processes=${python_processes//[[:space:]]/}
_assert_eq "hook startup: unsupported file starts one planner process" \
  1 "$python_processes"
python_calls=$(cat "$python_log")
_assert_not_contains "hook startup: shell does not resolve config in a separate interpreter" \
  "checkrun_paths.py config" "$python_calls"
_assert_contains "hook startup: registry planner still owns the no-op decision" \
  "registry.py shell-plan" "$python_calls"

if [[ "${CHECKRUN_HOOK_PERF_STRUCTURAL_ONLY:-0}" != 1 ]]; then
  perf_result=$(_measure_hook_perf "$AUTOFORMAT" "$unsupported")
  rc=$?
  median_budget_ms=$(_perf_budget_ms \
    "$CHECKRUN_FORMAT_HOOK_MEDIAN_BUDGET_MS" \
    "$CHECKRUN_FORMAT_HOOK_DARWIN_MEDIAN_BUDGET_MS")
  p95_budget_ms=$(_perf_budget_ms \
    "$CHECKRUN_FORMAT_HOOK_P95_BUDGET_MS" \
    "$CHECKRUN_FORMAT_HOOK_DARWIN_P95_BUDGET_MS")
  _assert_perf_result "unsupported autoformat" "$perf_result" "$rc" \
    "$median_budget_ms" "$p95_budget_ms"
fi

: >"$python_log"
CHECKRUN_REAL_PYTHON="$real_python" \
  CHECKRUN_PYTHON_LOG="$python_log" \
  CHECKRUN_PYTHON="$python_wrapper" \
  CHECKRUN_CONFIG_DIR=/nonexistent \
  CHECKRUN_SCHEMA_LINT=/nonexistent \
  PATH="$hook_path" \
  "$AUTOLINT" "$unsupported"
rc=$?
_assert_exit "hook startup: unsupported lint file exits 0" 0 "$rc"

python_processes=$(wc -l <"$python_log")
python_processes=${python_processes//[[:space:]]/}
_assert_eq "hook startup: unsupported lint starts one planner process" \
  1 "$python_processes"
python_calls=$(cat "$python_log")
_assert_not_contains "hook startup: lint shell does not resolve config separately" \
  "checkrun_paths.py config" "$python_calls"
_assert_contains "hook startup: lint registry planner owns the no-op decision" \
  "registry.py shell-plan" "$python_calls"
_assert_not_contains "hook startup: one file avoids manifest staging" \
  "--files0-from" "$python_calls"

# The manifest reaches autolint with a bounded argv, and autolint must keep the
# second Python boundary bounded too. Stub only execution after planning: this
# test owns transport shape, while registry/autolint behavior suites own plans.
large_shape_log="$td/large-shape.log"
: >"$large_shape_log"
CHECKRUN_LARGE_SHAPE_LOG="$large_shape_log" \
  CHECKRUN_AUTOLINT_JOBS=1 \
  CHECKRUN_CONFIG_DIR=/nonexistent \
  PATH="$hook_path" \
  bash -c '
    . "$1"
    shift
    _lintable_path_into() {
      printf -v "$1" "%s" "$2"
    }
    _checkrun_registry() {
      printf "argc:%s\n" "$#" >>"$CHECKRUN_LARGE_SHAPE_LOG"
      printf "args:" >>"$CHECKRUN_LARGE_SHAPE_LOG"
      printf "<%s>" "$@" >>"$CHECKRUN_LARGE_SHAPE_LOG"
      printf "\n" >>"$CHECKRUN_LARGE_SHAPE_LOG"
      local output_dir="" manifest="" arg index=0 path count=0
      while [[ "$#" -gt 0 ]]; do
        arg=$1
        shift
        case "$arg" in
          --output-dir) output_dir=$1; shift ;;
          --files0-from) manifest=$1; shift ;;
          --) break ;;
        esac
      done
      [[ -n "$manifest" ]] || return 99
      printf "manifest:%s\n" "$manifest" >>"$CHECKRUN_LARGE_SHAPE_LOG"
      while IFS= read -r -d "" path; do
        : >"$output_dir/$index.plan"
        index=$((index + 1))
        count=$((count + 1))
      done <"$manifest"
      printf "count:%s\n" "$count" >>"$CHECKRUN_LARGE_SHAPE_LOG"
    }
    _autolint_main --files0-from "$1" || exit
    _autolint_main --files0-from "$2" || exit
    _autolint_main "$3" "$4"
  ' _ "$CHECKRUN_REPO_ROOT/lib/checkrun/autolint.sh" \
  "$large_manifest" "$small_manifest" "${unsupported_batch[@]:0:2}"
rc=$?
_assert_exit "large files0: structural transport exits 0" 0 "$rc"
_assert_eq "large files0: one planner starts per request" 3 \
  "$(grep -c '^argc:' "$large_shape_log" || true)"
_assert_contains "large files0: planner receives a manifest" \
  "<--files0-from>" "$(cat "$large_shape_log")"
_assert_contains "large files0: planner receives every path" \
  "count:1000" "$(cat "$large_shape_log")"
_assert_contains "small files0: manifest input keeps the planner argv bounded" \
  "count:2" "$(cat "$large_shape_log")"
_assert_eq "multi-file positional input keeps the planner argv bounded" 2 \
  "$(grep -c '^count:2$' "$large_shape_log" || true)"
_assert_not_contains "large files0: planner does not receive positional separator" \
  "<-->" "$(cat "$large_shape_log")"
if [ "$(grep -Ec '^argc:7$' "$large_shape_log" || true)" -eq 3 ]; then
  _pass "large files0: planner argv remains bounded"
else
  _fail "large files0: planner argv is not bounded ($(cat "$large_shape_log"))"
fi

linter_log="$td/linter.log"
: >"$linter_log"
CHECKRUN_LINTER_LOG="$linter_log" \
  CHECKRUN_CONFIG_DIR=/nonexistent \
  CHECKRUN_SCHEMA_LINT=/nonexistent \
  PATH="$hook_path" \
  "$AUTOLINT" "${supported_batch[@]}"
rc=$?
_assert_exit "supported lint batch: clean files exit 0" 0 "$rc"
_assert_eq "supported lint batch: Typos uses five bounded commands for 300 files" 5 \
  "$(grep -c '^typos$' "$linter_log")"
_assert_eq "supported lint batch: Ruff uses five bounded commands for 300 files" 5 \
  "$(grep -c '^ruff$' "$linter_log")"

# A host without both procfs and ps cannot prove that the job-control leader
# owns a private process group. That removes safe parallel cancellation, not
# the planner's ability to batch read-only work in the foreground. Stub the
# expensive pieces so this 300-file shape assertion catches an accidental
# return to one planner/interpreter per file without making the test itself
# pay that pathological cost.
portable_shape_log="$td/portable-fallback-shape.log"
: >"$portable_shape_log"
CHECKRUN_PORTABLE_SHAPE_LOG="$portable_shape_log" \
  CHECKRUN_AUTOLINT_JOBS=8 \
  CHECKRUN_CONFIG_DIR=/nonexistent \
  PATH="$hook_path" \
  bash -c '
    . "$1"
    shift
    _autolint_read_proc_group() { return 1; }
    ps() { return 127; }
    _autolint_pre_plan() {
      printf "plan:%s\n" "$(($# - 1))" >>"$CHECKRUN_PORTABLE_SHAPE_LOG"
    }
    _autolint_try_clean_batch() {
      printf "batch:%s\n" "$(($# - 1))" >>"$CHECKRUN_PORTABLE_SHAPE_LOG"
      return 0
    }
    _lint_one() {
      printf "per-file\n" >>"$CHECKRUN_PORTABLE_SHAPE_LOG"
    }
    _autolint_main "$@"
  ' _ "$CHECKRUN_REPO_ROOT/lib/checkrun/autolint.sh" "${supported_batch[@]}"
rc=$?
_assert_exit "portable lint batch: capability fallback exits 0" 0 "$rc"
_assert_eq "portable lint batch: plans all 300 files once" 1 \
  "$(grep -c '^plan:300$' "$portable_shape_log" || true)"
_assert_eq "portable lint batch: forwards all 300 files to clean batching" 1 \
  "$(grep -c '^batch:300$' "$portable_shape_log" || true)"
_assert_eq "portable lint batch: does not restart planning per file" 0 \
  "$(grep -c '^per-file$' "$portable_shape_log" || true)"

# Non-batchable plans cannot use background workers on this path. With no
# validated PGID, a parent-only signal would otherwise kill the foreground
# shell and leave backend grandchildren running. Pin the safe runner selection
# structurally; readiness timing is not a proof that a second worker was never
# launched.
: >"$portable_shape_log"
CHECKRUN_PORTABLE_SHAPE_LOG="$portable_shape_log" \
  CHECKRUN_AUTOLINT_JOBS=8 \
  CHECKRUN_CONFIG_DIR=/nonexistent \
  PATH="$hook_path" \
  bash -c '
    . "$1"
    shift
    _autolint_read_proc_group() { return 1; }
    ps() { return 127; }
    _autolint_pre_plan() { :; }
    _autolint_try_clean_batch() { return 1; }
    _autolint_count_nonempty_plans() { REPLY=300; }
    _autolint_supports_pool() { return 0; }
    _autolint_run_files_pool() {
      printf "pool\n" >>"$CHECKRUN_PORTABLE_SHAPE_LOG"
    }
    _autolint_run_file_batch() {
      printf "wave\n" >>"$CHECKRUN_PORTABLE_SHAPE_LOG"
    }
    _autolint_run_plans_sequential() {
      printf "sequential\n" >>"$CHECKRUN_PORTABLE_SHAPE_LOG"
    }
    _autolint_main "$@"
  ' _ "$CHECKRUN_REPO_ROOT/lib/checkrun/autolint.sh" "${supported_batch[@]}"
rc=$?
_assert_exit "portable non-batch fallback: exits 0" 0 "$rc"
_assert_eq "portable non-batch fallback: selects foreground sequential runner" 1 \
  "$(grep -c '^sequential$' "$portable_shape_log" || true)"
_assert_eq "portable non-batch fallback: never selects worker pool" 0 \
  "$(grep -c '^pool$' "$portable_shape_log" || true)"
_assert_eq "portable non-batch fallback: never selects worker wave" 0 \
  "$(grep -c '^wave$' "$portable_shape_log" || true)"

# Exercise the real portable planner and adapters once outside the timer. The
# invocation count alone cannot prove that each chunk retained every pathname,
# so record and de-duplicate the actual .py arguments seen by both tools.
portable_linter_log="$td/portable-linter.log"
portable_path_log="$td/portable-paths.log"
: >"$portable_linter_log"
: >"$portable_path_log"
CHECKRUN_LINTER_LOG="$portable_linter_log" \
  CHECKRUN_LINTER_PATH_LOG="$portable_path_log" \
  CHECKRUN_CONFIG_DIR=/nonexistent \
  CHECKRUN_SCHEMA_LINT=/nonexistent \
  PATH="$hook_path" \
  "$portable_autolint" "${supported_batch[@]}"
rc=$?
_assert_exit "portable real batch: clean files exit 0" 0 "$rc"
_assert_eq "portable real batch: Typos keeps five bounded commands" 5 \
  "$(grep -c '^typos$' "$portable_linter_log")"
_assert_eq "portable real batch: Ruff keeps five bounded commands" 5 \
  "$(grep -c '^ruff$' "$portable_linter_log")"
_assert_eq "portable real batch: Typos receives 300 distinct paths" 300 \
  "$(awk -F '\t' '$1 == "typos" { print $2 }' "$portable_path_log" | sort -u | wc -l | tr -d '[:space:]')"
_assert_eq "portable real batch: Ruff receives 300 distinct paths" 300 \
  "$(awk -F '\t' '$1 == "ruff" { print $2 }' "$portable_path_log" | sort -u | wc -l | tr -d '[:space:]')"

empty_plan_dir="$td/empty-plans"
mkdir -p "$empty_plan_dir"
empty_plan_files=()
for index in "${!unsupported_batch[@]}"; do
  : >"$empty_plan_dir/$index.plan"
  empty_plan_files+=("${unsupported_batch[$index]}")
done

runner_path=$(_mock_bin)
for tool in bash cat; do
  ln -s "$(command -v "$tool")" "$runner_path/$tool"
done
real_mktemp=$(command -v mktemp)
real_rm=$(command -v rm)
mktemp_log="$td/empty-plan-mktemp.log"
rm_log="$td/empty-plan-rm.log"
worker_log="$td/empty-plan-worker.log"
cat >"$runner_path/mktemp" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$CHECKRUN_MKTEMP_LOG"
exec "$CHECKRUN_REAL_MKTEMP" "$@"
EOF
cat >"$runner_path/rm" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$CHECKRUN_RM_LOG"
exec "$CHECKRUN_REAL_RM" "$@"
EOF
chmod +x "$runner_path/mktemp" "$runner_path/rm"

pool_supported=0
if bash -c '
  . "$1"
  _autolint_supports_pool
' _ "$CHECKRUN_REPO_ROOT/lib/checkrun/autolint.sh"; then
  pool_supported=1
fi

_probe_empty_plan_runner() {
  local runner="$1" rc worker_count allocation_count

  : >"$mktemp_log"
  : >"$rm_log"
  : >"$worker_log"
  CHECKRUN_REAL_MKTEMP="$real_mktemp" \
    CHECKRUN_MKTEMP_LOG="$mktemp_log" \
    CHECKRUN_REAL_RM="$real_rm" \
    CHECKRUN_RM_LOG="$rm_log" \
    CHECKRUN_WORKER_LOG="$worker_log" \
    PATH="$runner_path" \
    bash -c '
      . "$1"
      runner=$2
      plan_dir=$3
      shift 3
      _lint_one_with_plan() {
        printf "%s\n" "$1" >>"$CHECKRUN_WORKER_LOG"
      }
      case "$runner" in
        pool) _autolint_run_files_pool 8 "$plan_dir" "$@" ;;
        barrier) _autolint_run_file_batch "$plan_dir" 0 "$@" ;;
      esac
    ' _ "$CHECKRUN_REPO_ROOT/lib/checkrun/autolint.sh" \
    "$runner" "$empty_plan_dir" "${empty_plan_files[@]}"
  rc=$?

  worker_count=$(wc -l <"$worker_log")
  worker_count=${worker_count//[[:space:]]/}
  allocation_count=$(wc -l <"$mktemp_log")
  allocation_count=${allocation_count//[[:space:]]/}
  _assert_exit "empty-plan batch: ${runner} runner exits 0" 0 "$rc"
  _assert_eq "empty-plan batch: ${runner} runner starts no workers" \
    0 "$worker_count"
  _assert_eq "empty-plan batch: ${runner} runner allocates no output files" \
    0 "$allocation_count"
}

if [[ "$pool_supported" == 1 ]]; then
  _probe_empty_plan_runner pool
else
  echo "  - skipping pool-runner assertions (wait -n unavailable)"
fi
_probe_empty_plan_runner barrier

mixed_plan_dir="$td/mixed-plans"
mkdir -p "$mixed_plan_dir"
: >"$mixed_plan_dir/0.plan"
printf 'step\n' >"$mixed_plan_dir/1.plan"
: >"$mixed_plan_dir/2.plan"
printf 'step\n' >"$mixed_plan_dir/3.plan"

_probe_mixed_plan_runner() {
  local runner="$1" output rc

  : >"$mktemp_log"
  : >"$rm_log"
  output=$(CHECKRUN_REAL_MKTEMP="$real_mktemp" \
    CHECKRUN_MKTEMP_LOG="$mktemp_log" \
    CHECKRUN_REAL_RM="$real_rm" \
    CHECKRUN_RM_LOG="$rm_log" \
    PATH="$runner_path" bash -c '
    . "$1"
    runner=$2
    plan_dir=$3
    shift 3
    _lint_one_with_plan() {
      plan=${1##*/}
      printf "%s\n" "$plan"
      case "$plan" in
        1.plan) return 1 ;;
        3.plan) return 2 ;;
      esac
    }
    if [[ "$runner" == pool-forgotten ]]; then
      # Bash is allowed to discard saved child statuses after enough later
      # children have completed. Model that boundary without launching
      # CHILD_MAX processes: wait -n still provides pool backpressure, while a
      # later exact wait reports the same 127 the real shell returns once its
      # saved entry is gone.
      wait() {
        if [[ "${1:-}" == -n ]]; then
          builtin wait "$@"
          return $?
        fi
        builtin wait "$@" >/dev/null 2>&1 || :
        return 127
      }
    fi
    case "$runner" in
      pool | pool-forgotten) _autolint_run_files_pool 2 "$plan_dir" "$@" ;;
      barrier) _autolint_run_file_batch "$plan_dir" 0 "$@" ;;
    esac
  ' _ "$CHECKRUN_REPO_ROOT/lib/checkrun/autolint.sh" \
    "$runner" "$mixed_plan_dir" \
    "${unsupported_batch[@]:0:4}")
  rc=$?

  _assert_exit "mixed-plan batch: ${runner} runner preserves strongest exit" 2 "$rc"
  _assert_eq "mixed-plan batch: ${runner} runner preserves non-empty plan order" \
    $'1.plan\n3.plan' "$output"
}

if [[ "$pool_supported" == 1 ]]; then
  _probe_mixed_plan_runner pool
  _probe_mixed_plan_runner pool-forgotten
fi
_probe_mixed_plan_runner barrier

if [[ "$pool_supported" == 1 ]]; then
  # Large commits legitimately send hundreds of selected files through this
  # path. Hold the first wave so this pins both the worker cap and the process
  # shape: buffering must not return to O(files) allocation/cleanup commands.
  large_plan_count=300
  large_plan_dir="$td/large-plans"
  large_release="$td/large-plans.release"
  mkdir -p "$large_plan_dir"
  large_plan_files=()
  for ((index = 0; index < large_plan_count; index++)); do
    printf 'step\n' >"$large_plan_dir/$index.plan"
    large_plan_files+=("$td/large-$index.txt")
  done

  : >"$mktemp_log"
  : >"$rm_log"
  : >"$worker_log"
  CHECKRUN_REAL_MKTEMP="$real_mktemp" \
    CHECKRUN_MKTEMP_LOG="$mktemp_log" \
    CHECKRUN_REAL_RM="$real_rm" \
    CHECKRUN_RM_LOG="$rm_log" \
    CHECKRUN_WORKER_LOG="$worker_log" \
    CHECKRUN_POOL_RELEASE="$large_release" \
    CHECKRUN_REAL_SLEEP="$(command -v sleep)" \
    PATH="$runner_path" \
    bash -c '
      . "$1"
      plan_dir=$2
      shift 2
      _lint_one_with_plan() {
        plan=${1##*/}
        printf "%s\n" "$plan" >>"$CHECKRUN_WORKER_LOG"
        case "$plan" in
          0.plan | 1.plan)
            while [ ! -e "$CHECKRUN_POOL_RELEASE" ]; do
              "$CHECKRUN_REAL_SLEEP" 0.01
            done
            ;;
        esac
      }
      _autolint_run_files_pool 2 "$plan_dir" "$@"
    ' _ "$CHECKRUN_REPO_ROOT/lib/checkrun/autolint.sh" \
    "$large_plan_dir" "${large_plan_files[@]}" >/dev/null 2>&1 &
  large_runner_pid=$!

  for ((index = 0; index < 500; index++)); do
    [[ "$(wc -l <"$worker_log")" -ge 2 ]] && break
    sleep 0.01
  done
  large_blocked_count=$(wc -l <"$worker_log")
  large_blocked_count=${large_blocked_count//[[:space:]]/}
  _assert_eq "nonempty-plan batch: pool honors the worker cap" \
    2 "$large_blocked_count"

  : >"$large_release"
  wait "$large_runner_pid"
  rc=$?

  large_worker_count=$(wc -l <"$worker_log")
  large_worker_count=${large_worker_count//[[:space:]]/}
  large_allocation_count=$(wc -l <"$mktemp_log")
  large_allocation_count=${large_allocation_count//[[:space:]]/}
  large_cleanup_count=$(wc -l <"$rm_log")
  large_cleanup_count=${large_cleanup_count//[[:space:]]/}
  _assert_exit "nonempty-plan batch: pool runner exits 0" 0 "$rc"
  _assert_eq "nonempty-plan batch: pool starts every worker" \
    "$large_plan_count" "$large_worker_count"
  _assert_eq "nonempty-plan batch: pool invokes no per-worker allocators" \
    0 "$large_allocation_count"
  _assert_eq "nonempty-plan batch: pool invokes no per-worker cleanup commands" \
    0 "$large_cleanup_count"
else
  echo "  - skipping nonempty pool-runner assertions (wait -n unavailable)"
fi

if [[ "${CHECKRUN_HOOK_PERF_STRUCTURAL_ONLY:-0}" != 1 ]]; then
  perf_result=$(_measure_hook_perf "$AUTOLINT" "$unsupported")
  rc=$?
  median_budget_ms=$(_perf_budget_ms \
    "$CHECKRUN_LINT_HOOK_MEDIAN_BUDGET_MS" \
    "$CHECKRUN_LINT_HOOK_DARWIN_MEDIAN_BUDGET_MS")
  p95_budget_ms=$(_perf_budget_ms \
    "$CHECKRUN_LINT_HOOK_P95_BUDGET_MS" \
    "$CHECKRUN_LINT_HOOK_DARWIN_P95_BUDGET_MS")
  _assert_perf_result "unsupported autolint" "$perf_result" "$rc" \
    "$median_budget_ms" "$p95_budget_ms"

  perf_result=$(_measure_hook_perf "$AUTOLINT" "${unsupported_batch[@]}")
  rc=$?
  median_budget_ms=$(_perf_budget_ms \
    "$CHECKRUN_EMPTY_BATCH_MEDIAN_BUDGET_MS" \
    "$CHECKRUN_EMPTY_BATCH_DARWIN_MEDIAN_BUDGET_MS")
  p95_budget_ms=$(_perf_budget_ms \
    "$CHECKRUN_EMPTY_BATCH_P95_BUDGET_MS" \
    "$CHECKRUN_EMPTY_BATCH_DARWIN_P95_BUDGET_MS")
  _assert_perf_result "20-file unsupported autolint batch" "$perf_result" "$rc" \
    "$median_budget_ms" "$p95_budget_ms"

  # The sequential capability fallback still has to amortize planning and
  # clean-adapter startup, so a minimal host is not grounds to skip this gate.
  default_perf_runs=$CHECKRUN_HOOK_PERF_RUNS
  CHECKRUN_HOOK_PERF_RUNS=$CHECKRUN_SUPPORTED_BATCH_RUNS
  median_budget_ms=$(_perf_budget_ms \
    "$CHECKRUN_SUPPORTED_BATCH_MEDIAN_BUDGET_MS" \
    "$CHECKRUN_SUPPORTED_BATCH_DARWIN_MEDIAN_BUDGET_MS")
  p95_budget_ms=$(_perf_budget_ms \
    "$CHECKRUN_SUPPORTED_BATCH_P95_BUDGET_MS" \
    "$CHECKRUN_SUPPORTED_BATCH_DARWIN_P95_BUDGET_MS")

  # Keep the default supervised path under the same large-commit budget. The
  # portable probe supplements this developer path; it must not replace it.
  perf_result=$(_measure_hook_perf "$AUTOLINT" "${supported_batch[@]}")
  rc=$?
  _assert_perf_result "300-file supported autolint batch" "$perf_result" "$rc" \
    "$median_budget_ms" "$p95_budget_ms"

  perf_result=$(_measure_hook_perf "$portable_autolint" "${supported_batch[@]}")
  rc=$?
  _assert_perf_result "portable 300-file supported autolint batch" "$perf_result" "$rc" \
    "$median_budget_ms" "$p95_budget_ms"
  CHECKRUN_HOOK_PERF_RUNS=$default_perf_runs
fi

_test_summary
